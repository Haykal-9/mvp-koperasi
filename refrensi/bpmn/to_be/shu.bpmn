<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://koperasi.id/bpmn"
             id="ToBe_SHU">
  <collaboration id="Collab_1">
    <participant id="Pool_1" name="KSP Koperasi — SHU (To-Be)" processRef="Proc_1"/>
  </collaboration>
  <process id="Proc_1" isExecutable="false">
    <laneSet id="LS_1">
      <lane id="Lane_Owner" name="Owner (Backoffice Vue.js)">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>Task_TinjauDraft</flowNodeRef>
        <flowNodeRef>GW_Setuju</flowNodeRef>
        <flowNodeRef>Task_KoreksiParam</flowNodeRef>
        <flowNodeRef>Task_PresentasiRAT</flowNodeRef>
        <flowNodeRef>Task_TombolDistribusi</flowNodeRef>
      </lane>
      <lane id="Lane_GoBackend" name="Go Backend (Kalkulasi Otomatis)">
        <flowNodeRef>Task_CekBukuTutup</flowNodeRef>
        <flowNodeRef>GW_BukuTutup</flowNodeRef>
        <flowNodeRef>Task_KunciMutasi</flowNodeRef>
        <flowNodeRef>Task_TarikDataTransaksi</flowNodeRef>
        <flowNodeRef>Task_HitungOtomatis</flowNodeRef>
        <flowNodeRef>Task_GenerateDraft</flowNodeRef>
        <flowNodeRef>Task_HitungUlang</flowNodeRef>
        <flowNodeRef>Task_EksekusiTransfer</flowNodeRef>
        <flowNodeRef>Task_KirimFCM</flowNodeRef>
        <flowNodeRef>End_Gagal</flowNodeRef>
      </lane>
      <lane id="Lane_Anggota" name="Anggota (Flutter App)">
        <flowNodeRef>Task_LihatSHUApp</flowNodeRef>
        <flowNodeRef>End_1</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="Owner klik Mulai Kalkulasi SHU di dasbor Vue.js"><outgoing>F1</outgoing></startEvent>
    <serviceTask id="Task_CekBukuTutup" name="Go Backend validasi: tahun buku sudah ditutup dan laporan keuangan sudah final?"><incoming>F1</incoming><outgoing>F2</outgoing></serviceTask>
    <exclusiveGateway id="GW_BukuTutup" name="Buku sudah ditutup?"><incoming>F2</incoming><outgoing>F_Belum</outgoing><outgoing>F_Sudah</outgoing></exclusiveGateway>
    <endEvent id="End_Gagal" name="Notif error: Tutup buku terlebih dahulu"><incoming>F_Belum</incoming></endEvent>
    <serviceTask id="Task_KunciMutasi" name="Lock sementara seluruh mutasi transaksi (data tidak berubah selama kalkulasi)"><incoming>F_Sudah</incoming><outgoing>F3</outgoing></serviceTask>
    <serviceTask id="Task_TarikDataTransaksi" name="Tarik: total laba bersih, data simpanan (jasa modal), kontribusi pinjaman tiap Anggota (jasa usaha)"><incoming>F3</incoming><outgoing>F4</outgoing></serviceTask>
    <serviceTask id="Task_HitungOtomatis" name="Hitung otomatis: alokasi SHU sesuai config AD/ART, porsi tiap Anggota (Go Backend)"><incoming>F4</incoming><incoming>F_Ulang</incoming><outgoing>F5</outgoing></serviceTask>
    <serviceTask id="Task_GenerateDraft" name="Generate draft laporan distribusi SHU (bisa diekspor PDF/Excel)"><incoming>F5</incoming><outgoing>F6</outgoing></serviceTask>
    <userTask id="Task_TinjauDraft" name="Owner tinjau draft laporan SHU di dasbor backoffice Vue.js"><incoming>F6</incoming><outgoing>F7</outgoing></userTask>
    <exclusiveGateway id="GW_Setuju" name="Owner setuju?"><incoming>F7</incoming><outgoing>F_Tidak</outgoing><outgoing>F_Ya</outgoing></exclusiveGateway>
    <userTask id="Task_KoreksiParam" name="Owner koreksi parameter/data di dasbor"><incoming>F_Tidak</incoming><outgoing>F8</outgoing></userTask>
    <serviceTask id="Task_HitungUlang" name="Go Backend hitung ulang SHU secara otomatis berdasarkan koreksi"><incoming>F8</incoming><outgoing>F_Ulang</outgoing></serviceTask>
    <userTask id="Task_PresentasiRAT" name="Owner presentasi laporan distribusi SHU dalam RAT (laporan digenerate otomatis)"><incoming>F_Ya</incoming><outgoing>F9</outgoing></userTask>
    <userTask id="Task_TombolDistribusi" name="Owner klik Distribusikan SHU di dasbor backoffice Vue.js"><incoming>F9</incoming><outgoing>F10</outgoing></userTask>
    <serviceTask id="Task_EksekusiTransfer" name="Go Backend eksekusi transfer SHU ke dompet digital / simpanan sukarela tiap Anggota otomatis"><incoming>F10</incoming><outgoing>F11</outgoing></serviceTask>
    <serviceTask id="Task_KirimFCM" name="Kirim push notification FCM dengan rincian SHU ke Flutter app tiap Anggota"><incoming>F11</incoming><outgoing>F12</outgoing></serviceTask>
    <userTask id="Task_LihatSHUApp" name="Anggota lihat rincian SHU yang diterima di Flutter app (Android/iOS/Web) kapan saja"><incoming>F12</incoming><outgoing>F13</outgoing></userTask>
    <endEvent id="End_1" name="SHU terdistribusi — rincian tersedia di Flutter app tiap Anggota"><incoming>F13</incoming></endEvent>
    <sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_CekBukuTutup"/>
    <sequenceFlow id="F2" sourceRef="Task_CekBukuTutup" targetRef="GW_BukuTutup"/>
    <sequenceFlow id="F_Belum" name="Belum" sourceRef="GW_BukuTutup" targetRef="End_Gagal"/>
    <sequenceFlow id="F_Sudah" name="Sudah" sourceRef="GW_BukuTutup" targetRef="Task_KunciMutasi"/>
    <sequenceFlow id="F3" sourceRef="Task_KunciMutasi" targetRef="Task_TarikDataTransaksi"/>
    <sequenceFlow id="F4" sourceRef="Task_TarikDataTransaksi" targetRef="Task_HitungOtomatis"/>
    <sequenceFlow id="F5" sourceRef="Task_HitungOtomatis" targetRef="Task_GenerateDraft"/>
    <sequenceFlow id="F6" sourceRef="Task_GenerateDraft" targetRef="Task_TinjauDraft"/>
    <sequenceFlow id="F7" sourceRef="Task_TinjauDraft" targetRef="GW_Setuju"/>
    <sequenceFlow id="F_Tidak" name="Koreksi" sourceRef="GW_Setuju" targetRef="Task_KoreksiParam"/>
    <sequenceFlow id="F8" sourceRef="Task_KoreksiParam" targetRef="Task_HitungUlang"/>
    <sequenceFlow id="F_Ulang" sourceRef="Task_HitungUlang" targetRef="Task_HitungOtomatis"/>
    <sequenceFlow id="F_Ya" name="Setuju" sourceRef="GW_Setuju" targetRef="Task_PresentasiRAT"/>
    <sequenceFlow id="F9" sourceRef="Task_PresentasiRAT" targetRef="Task_TombolDistribusi"/>
    <sequenceFlow id="F10" sourceRef="Task_TombolDistribusi" targetRef="Task_EksekusiTransfer"/>
    <sequenceFlow id="F11" sourceRef="Task_EksekusiTransfer" targetRef="Task_KirimFCM"/>
    <sequenceFlow id="F12" sourceRef="Task_KirimFCM" targetRef="Task_LihatSHUApp"/>
    <sequenceFlow id="F13" sourceRef="Task_LihatSHUApp" targetRef="End_1"/>
  </process>
  <bpmndi:BPMNDiagram id="Diag_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collab_1">
      <bpmndi:BPMNShape id="Pool_1_di" bpmnElement="Pool_1" isHorizontal="true"><dc:Bounds x="80" y="50" width="1500" height="600"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Owner_di" bpmnElement="Lane_Owner" isHorizontal="true"><dc:Bounds x="110" y="50" width="1470" height="150"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_GoBackend_di" bpmnElement="Lane_GoBackend" isHorizontal="true"><dc:Bounds x="110" y="200" width="1470" height="270"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Anggota_di" bpmnElement="Lane_Anggota" isHorizontal="true"><dc:Bounds x="110" y="470" width="1470" height="180"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1"><dc:Bounds x="142" y="103" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CekBukuTutup_di" bpmnElement="Task_CekBukuTutup"><dc:Bounds x="220" y="228" width="120" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_BukuTutup_di" bpmnElement="GW_BukuTutup" isMarkerVisible="true"><dc:Bounds x="390" y="241" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Gagal_di" bpmnElement="End_Gagal"><dc:Bounds x="492" y="385" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_KunciMutasi_di" bpmnElement="Task_KunciMutasi"><dc:Bounds x="490" y="228" width="120" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TarikDataTransaksi_di" bpmnElement="Task_TarikDataTransaksi"><dc:Bounds x="660" y="228" width="120" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_HitungOtomatis_di" bpmnElement="Task_HitungOtomatis"><dc:Bounds x="830" y="228" width="120" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GenerateDraft_di" bpmnElement="Task_GenerateDraft"><dc:Bounds x="1000" y="228" width="120" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_HitungUlang_di" bpmnElement="Task_HitungUlang"><dc:Bounds x="830" y="360" width="120" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TinjauDraft_di" bpmnElement="Task_TinjauDraft"><dc:Bounds x="1160" y="78" width="120" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Setuju_di" bpmnElement="GW_Setuju" isMarkerVisible="true"><dc:Bounds x="1330" y="91" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_KoreksiParam_di" bpmnElement="Task_KoreksiParam"><dc:Bounds x="1320" y="228" width="120" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PresentasiRAT_di" bpmnElement="Task_PresentasiRAT"><dc:Bounds x="1420" y="78" width="120" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TombolDistribusi_di" bpmnElement="Task_TombolDistribusi"><dc:Bounds x="1420" y="228" width="120" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EksekusiTransfer_di" bpmnElement="Task_EksekusiTransfer"><dc:Bounds x="1420" y="360" width="120" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_KirimFCM_di" bpmnElement="Task_KirimFCM"><dc:Bounds x="1260" y="360" width="120" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_LihatSHUApp_di" bpmnElement="Task_LihatSHUApp"><dc:Bounds x="1260" y="505" width="120" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_1_di" bpmnElement="End_1"><dc:Bounds x="1422" y="525" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="178" y="121"/><di:waypoint x="280" y="228"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="340" y="266"/><di:waypoint x="390" y="266"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Belum_di" bpmnElement="F_Belum"><di:waypoint x="415" y="291"/><di:waypoint x="510" y="385"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Sudah_di" bpmnElement="F_Sudah"><di:waypoint x="440" y="266"/><di:waypoint x="490" y="266"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="610" y="266"/><di:waypoint x="660" y="266"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="780" y="266"/><di:waypoint x="830" y="266"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="950" y="266"/><di:waypoint x="1000" y="266"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="1120" y="266"/><di:waypoint x="1220" y="116"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="1280" y="116"/><di:waypoint x="1330" y="116"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Tidak_di" bpmnElement="F_Tidak"><di:waypoint x="1355" y="141"/><di:waypoint x="1380" y="266"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="1320" y="266"/><di:waypoint x="890" y="360"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Ulang_di" bpmnElement="F_Ulang"><di:waypoint x="890" y="360"/><di:waypoint x="890" y="303"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Ya_di" bpmnElement="F_Ya"><di:waypoint x="1380" y="116"/><di:waypoint x="1420" y="116"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="1480" y="153"/><di:waypoint x="1480" y="228"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="1480" y="303"/><di:waypoint x="1480" y="360"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11"><di:waypoint x="1420" y="398"/><di:waypoint x="1380" y="398"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F12_di" bpmnElement="F12"><di:waypoint x="1320" y="435"/><di:waypoint x="1320" y="505"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F13_di" bpmnElement="F13"><di:waypoint x="1380" y="543"/><di:waypoint x="1422" y="543"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>