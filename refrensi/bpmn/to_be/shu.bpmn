<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Proc_ToBe_SHU" targetNamespace="http://smartcoop.id/bpmn/revisi" exporter="Camunda Modeler" exporterVersion="5.47.0">
  <documentation>Revisi BPMN To-Be: proses SHU tahunan dengan data terintegrasi, kalkulasi kontribusi anggota, validasi pengurus, keputusan RAT, dan distribusi SHU.</documentation>
  <collaboration id="Collab_ToBe_SHU">
    <participant id="Participant_ToBe_SHU" name="SmartCoop - To-Be SHU" processRef="Proc_ToBe_SHU" />
  </collaboration>
  <process id="Proc_ToBe_SHU" isExecutable="false">
    <documentation>Revisi BPMN To-Be: proses SHU tahunan dengan data terintegrasi, kalkulasi kontribusi anggota, validasi pengurus, keputusan RAT, dan distribusi SHU.</documentation>
    <laneSet id="LaneSet_Proc_ToBe_SHU">
      <lane id="Lane_4_SmartCoop" name="SmartCoop">
        <flowNodeRef>Task_KunciData</flowNodeRef>
        <flowNodeRef>PG_Kalkulasi</flowNodeRef>
        <flowNodeRef>Task_JasaUsaha</flowNodeRef>
        <flowNodeRef>Task_JasaModal</flowNodeRef>
        <flowNodeRef>PG_Gabung</flowNodeRef>
        <flowNodeRef>Start_AkhirTahun</flowNodeRef>
        <flowNodeRef>Task_TetapkanSHU</flowNodeRef>
      </lane>
      <lane id="Lane_3_Pengurus" name="Pengurus">
        <flowNodeRef>Task_TutupPeriode</flowNodeRef>
        <flowNodeRef>Task_Tinjau</flowNodeRef>
        <flowNodeRef>GW_Valid</flowNodeRef>
        <flowNodeRef>Task_AjukanRAT</flowNodeRef>
        <flowNodeRef>Task_Koreksi</flowNodeRef>
      </lane>
      <lane id="Lane_2_Kasir_Keuangan" name="Kasir / Keuangan">
        <flowNodeRef>Task_RingkasanLaba</flowNodeRef>
        <flowNodeRef>Task_BayarSHU</flowNodeRef>
      </lane>
      <lane id="Lane_1_Anggota_RAT" name="Anggota / RAT">
        <flowNodeRef>GW_KeputusanRAT</flowNodeRef>
        <flowNodeRef>Evt_RATRevisi</flowNodeRef>
        <flowNodeRef>Evt_RATSetuju</flowNodeRef>
        <flowNodeRef>End_Selesai</flowNodeRef>
      </lane>
    </laneSet>
    <userTask id="Task_TutupPeriode" name="Menutup periode transaksi koperasi">
      <incoming>F1</incoming>
      <outgoing>F2</outgoing>
    </userTask>
    <sequenceFlow id="F2" sourceRef="Task_TutupPeriode" targetRef="Task_KunciData" />
    <sequenceFlow id="F9_Ulang" name="Perbaiki dan hitung ulang" sourceRef="Task_Koreksi" targetRef="Task_KunciData" />
    <sequenceFlow id="F4c" sourceRef="PG_Kalkulasi" targetRef="Task_RingkasanLaba" />
    <sequenceFlow id="F5a" sourceRef="Task_JasaModal" targetRef="PG_Gabung" />
    <sequenceFlow id="F5b" sourceRef="Task_JasaUsaha" targetRef="PG_Gabung" />
    <sequenceFlow id="F5c" sourceRef="Task_RingkasanLaba" targetRef="PG_Gabung" />
    <sequenceFlow id="F6" sourceRef="PG_Gabung" targetRef="Task_Tinjau" />
    <sequenceFlow id="F7" sourceRef="Task_Tinjau" targetRef="GW_Valid" />
    <sequenceFlow id="F8_Tidak" name="Tidak" sourceRef="GW_Valid" targetRef="Task_Koreksi" />
    <sequenceFlow id="F10_Ya" name="Ya" sourceRef="GW_Valid" targetRef="Task_AjukanRAT" />
    <sequenceFlow id="F16_Revisi" name="Koreksi" sourceRef="Evt_RATRevisi" targetRef="Task_Koreksi" />
    <sequenceFlow id="F11" sourceRef="Task_AjukanRAT" targetRef="GW_KeputusanRAT" />
    <sequenceFlow id="F12a" name="Disetujui" sourceRef="GW_KeputusanRAT" targetRef="Evt_RATSetuju" />
    <sequenceFlow id="F12b" name="Revisi" sourceRef="GW_KeputusanRAT" targetRef="Evt_RATRevisi" />
    <sequenceFlow id="F13" sourceRef="Evt_RATSetuju" targetRef="Task_TetapkanSHU" />
    <sequenceFlow id="F14" sourceRef="Task_TetapkanSHU" targetRef="Task_BayarSHU" />
    <sequenceFlow id="F15" sourceRef="Task_BayarSHU" targetRef="End_Selesai" />
    <sequenceFlow id="F1" sourceRef="Start_AkhirTahun" targetRef="Task_TutupPeriode" />
    <serviceTask id="Task_RingkasanLaba" name="Menyiapkan ringkasan laba dan dana cadangan">
      <incoming>F4c</incoming>
      <outgoing>F5c</outgoing>
    </serviceTask>
    <userTask id="Task_Tinjau" name="Meninjau rancangan pembagian SHU">
      <incoming>F6</incoming>
      <outgoing>F7</outgoing>
    </userTask>
    <exclusiveGateway id="GW_Valid" name="Rancangan valid?">
      <incoming>F7</incoming>
      <outgoing>F8_Tidak</outgoing>
      <outgoing>F10_Ya</outgoing>
    </exclusiveGateway>
    <userTask id="Task_AjukanRAT" name="Mengajukan rancangan SHU ke RAT">
      <incoming>F10_Ya</incoming>
      <outgoing>F11</outgoing>
    </userTask>
    <serviceTask id="Task_KunciData" name="Mengunci data tahun buku dan menarik kontribusi anggota">
      <incoming>F2</incoming>
      <incoming>F9_Ulang</incoming>
      <outgoing>F3</outgoing>
    </serviceTask>
    <parallelGateway id="PG_Kalkulasi" name="Kalkulasi tahunan">
      <incoming>F3</incoming>
      <outgoing>F4a</outgoing>
      <outgoing>F4b</outgoing>
      <outgoing>F4c</outgoing>
    </parallelGateway>
    <sequenceFlow id="F3" sourceRef="Task_KunciData" targetRef="PG_Kalkulasi" />
    <sequenceFlow id="F4a" sourceRef="PG_Kalkulasi" targetRef="Task_JasaModal" />
    <sequenceFlow id="F4b" sourceRef="PG_Kalkulasi" targetRef="Task_JasaUsaha" />
    <serviceTask id="Task_JasaModal" name="Menghitung jasa modal dari simpanan">
      <incoming>F4a</incoming>
      <outgoing>F5a</outgoing>
    </serviceTask>
    <serviceTask id="Task_JasaUsaha" name="Menghitung jasa usaha dari transaksi dan pinjaman">
      <incoming>F4b</incoming>
      <outgoing>F5b</outgoing>
    </serviceTask>
    <parallelGateway id="PG_Gabung">
      <incoming>F5a</incoming>
      <incoming>F5b</incoming>
      <incoming>F5c</incoming>
      <outgoing>F6</outgoing>
    </parallelGateway>
    <startEvent id="Start_AkhirTahun" name="Akhir tahun buku">
      <outgoing>F1</outgoing>
      <timerEventDefinition />
    </startEvent>
    <userTask id="Task_Koreksi" name="Mengoreksi data sumber atau parameter pembagian">
      <incoming>F8_Tidak</incoming>
      <incoming>F16_Revisi</incoming>
      <outgoing>F9_Ulang</outgoing>
    </userTask>
    <eventBasedGateway id="GW_KeputusanRAT" name="Keputusan RAT">
      <incoming>F11</incoming>
      <outgoing>F12a</outgoing>
      <outgoing>F12b</outgoing>
    </eventBasedGateway>
    <intermediateCatchEvent id="Evt_RATRevisi" name="RAT meminta revisi">
      <incoming>F12b</incoming>
      <outgoing>F16_Revisi</outgoing>
      <messageEventDefinition />
    </intermediateCatchEvent>
    <intermediateCatchEvent id="Evt_RATSetuju" name="RAT menyetujui">
      <incoming>F12a</incoming>
      <outgoing>F13</outgoing>
      <messageEventDefinition />
    </intermediateCatchEvent>
    <serviceTask id="Task_TetapkanSHU" name="Menetapkan SHU per anggota dan membuat bukti">
      <incoming>F13</incoming>
      <outgoing>F14</outgoing>
    </serviceTask>
    <userTask id="Task_BayarSHU" name="Membayarkan SHU atau menambahkan ke saldo">
      <incoming>F14</incoming>
      <outgoing>F15</outgoing>
    </userTask>
    <endEvent id="End_Selesai" name="SHU diterima anggota">
      <incoming>F15</incoming>
    </endEvent>
  </process>
  <bpmndi:BPMNDiagram id="Diagram_Proc_ToBe_SHU">
    <bpmndi:BPMNPlane id="Plane_Proc_ToBe_SHU" bpmnElement="Collab_ToBe_SHU">
