<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Proc_ToBe_ManajemenAnggota" targetNamespace="http://smartcoop.id/bpmn/revisi" exporter="Camunda Modeler" exporterVersion="5.47.0">
  <documentation>Revisi BPMN To-Be: proses bisnis pendaftaran anggota digital dengan validasi, keputusan pengurus, setoran awal, dan aktivasi anggota.</documentation>
  <collaboration id="Collab_ToBe_ManajemenAnggota">
    <participant id="Participant_ToBe_ManajemenAnggota" name="SmartCoop - To-Be Manajemen Anggota" processRef="Proc_ToBe_ManajemenAnggota" />
  </collaboration>
  <process id="Proc_ToBe_ManajemenAnggota" isExecutable="false">
    <documentation>Revisi BPMN To-Be: proses bisnis pendaftaran anggota digital dengan validasi, keputusan pengurus, setoran awal, dan aktivasi anggota.</documentation>
    <laneSet id="LaneSet_Proc_ToBe_ManajemenAnggota">
      <lane id="Lane_1_Calon_Anggota" name="Calon Anggota">
        <flowNodeRef>Task_DaftarOnline</flowNodeRef>
        <flowNodeRef>Start_Digital</flowNodeRef>
        <flowNodeRef>Task_Perbaiki</flowNodeRef>
        <flowNodeRef>End_Tolak</flowNodeRef>
        <flowNodeRef>Task_TerimaKartu</flowNodeRef>
        <flowNodeRef>End_Aktif</flowNodeRef>
        <flowNodeRef>End_Kedaluwarsa</flowNodeRef>
      </lane>
      <lane id="Lane_2_Kasir_Keuangan" name="Kasir / Keuangan">
        <flowNodeRef>Evt_BayarMasuk</flowNodeRef>
      </lane>
      <lane id="Lane_3_Pengurus" name="Pengurus">
        <flowNodeRef>Task_Review</flowNodeRef>
        <flowNodeRef>GW_Setuju</flowNodeRef>
      </lane>
      <lane id="Lane_4_SmartCoop" name="SmartCoop">
        <flowNodeRef>Task_CekAwal</flowNodeRef>
        <flowNodeRef>Task_MintaPerbaikan</flowNodeRef>
        <flowNodeRef>GW_DataLengkap</flowNodeRef>
        <flowNodeRef>Task_KirimTolak</flowNodeRef>
        <flowNodeRef>Task_InstruksiBayar</flowNodeRef>
        <flowNodeRef>GW_TungguBayar</flowNodeRef>
        <flowNodeRef>Task_Aktifkan</flowNodeRef>
        <flowNodeRef>Task_VerifikasiBayar</flowNodeRef>
        <flowNodeRef>Evt_BatasLewat</flowNodeRef>
      </lane>
    </laneSet>
    <sequenceFlow id="F6_Ulang" name="Kirim ulang" sourceRef="Task_Perbaiki" targetRef="Task_CekAwal" />
    <sequenceFlow id="F8" sourceRef="Task_Review" targetRef="GW_Setuju" />
    <sequenceFlow id="F5" sourceRef="Task_MintaPerbaikan" targetRef="Task_Perbaiki" />
    <sequenceFlow id="F7_Ya" name="Ya" sourceRef="GW_DataLengkap" targetRef="Task_Review" />
    <sequenceFlow id="F4_Tidak" name="Tidak" sourceRef="GW_DataLengkap" targetRef="Task_MintaPerbaikan" />
    <sequenceFlow id="F3" sourceRef="Task_CekAwal" targetRef="GW_DataLengkap" />
    <sequenceFlow id="F11_Ya" name="Ya" sourceRef="GW_Setuju" targetRef="Task_InstruksiBayar" />
    <sequenceFlow id="F9_Tidak" name="Tidak" sourceRef="GW_Setuju" targetRef="Task_KirimTolak" />
    <sequenceFlow id="F2" sourceRef="Task_DaftarOnline" targetRef="Task_CekAwal" />
    <sequenceFlow id="F1" sourceRef="Start_Digital" targetRef="Task_DaftarOnline" />
    <userTask id="Task_DaftarOnline" name="Mengisi pendaftaran digital dan unggah dokumen">
      <incoming>F1</incoming>
      <outgoing>F2</outgoing>
    </userTask>
    <startEvent id="Start_Digital" name="Calon anggota ingin bergabung">
      <outgoing>F1</outgoing>
    </startEvent>
    <userTask id="Task_Perbaiki" name="Memperbaiki data pendaftaran">
      <incoming>F5</incoming>
      <outgoing>F6_Ulang</outgoing>
    </userTask>
    <sequenceFlow id="F10" sourceRef="Task_KirimTolak" targetRef="End_Tolak" />
    <sequenceFlow id="F18" sourceRef="Evt_BatasLewat" targetRef="End_Kedaluwarsa" />
    <sequenceFlow id="F17" sourceRef="Task_TerimaKartu" targetRef="End_Aktif" />
    <sequenceFlow id="F16" sourceRef="Task_Aktifkan" targetRef="Task_TerimaKartu" />
    <sequenceFlow id="F12" sourceRef="Task_InstruksiBayar" targetRef="GW_TungguBayar" />
    <sequenceFlow id="F13b" name="Lewat waktu" sourceRef="GW_TungguBayar" targetRef="Evt_BatasLewat" />
    <sequenceFlow id="F13a" name="Dibayar" sourceRef="GW_TungguBayar" targetRef="Evt_BayarMasuk" />
    <sequenceFlow id="F14" sourceRef="Evt_BayarMasuk" targetRef="Task_VerifikasiBayar" />
    <serviceTask id="Task_CekAwal" name="Memeriksa kelengkapan dan duplikasi data">
      <incoming>F2</incoming>
      <incoming>F6_Ulang</incoming>
      <outgoing>F3</outgoing>
    </serviceTask>
    <sendTask id="Task_MintaPerbaikan" name="Meminta perbaikan data kepada calon anggota">
      <incoming>F4_Tidak</incoming>
      <outgoing>F5</outgoing>
    </sendTask>
    <exclusiveGateway id="GW_DataLengkap" name="Data lengkap?">
      <incoming>F3</incoming>
      <outgoing>F4_Tidak</outgoing>
      <outgoing>F7_Ya</outgoing>
    </exclusiveGateway>
    <userTask id="Task_Review" name="Menilai kelayakan calon anggota">
      <incoming>F7_Ya</incoming>
      <outgoing>F8</outgoing>
    </userTask>
    <exclusiveGateway id="GW_Setuju" name="Disetujui?">
      <incoming>F8</incoming>
      <outgoing>F9_Tidak</outgoing>
      <outgoing>F11_Ya</outgoing>
    </exclusiveGateway>
    <sendTask id="Task_KirimTolak" name="Menyampaikan hasil penolakan">
      <incoming>F9_Tidak</incoming>
      <outgoing>F10</outgoing>
    </sendTask>
    <sendTask id="Task_InstruksiBayar" name="Mengirim instruksi setoran awal">
      <incoming>F11_Ya</incoming>
      <outgoing>F12</outgoing>
    </sendTask>
    <endEvent id="End_Tolak" name="Pendaftaran ditolak">
      <incoming>F10</incoming>
    </endEvent>
    <eventBasedGateway id="GW_TungguBayar" name="Menunggu setoran awal">
      <incoming>F12</incoming>
      <outgoing>F13a</outgoing>
      <outgoing>F13b</outgoing>
    </eventBasedGateway>
    <intermediateCatchEvent id="Evt_BayarMasuk" name="Setoran awal diterima">
      <incoming>F13a</incoming>
      <outgoing>F14</outgoing>
      <messageEventDefinition />
    </intermediateCatchEvent>
    <sequenceFlow id="F15" sourceRef="Task_VerifikasiBayar" targetRef="Task_Aktifkan" />
    <serviceTask id="Task_Aktifkan" name="Membuat nomor anggota, akun simpanan, dan kartu digital">
      <incoming>F15</incoming>
      <outgoing>F16</outgoing>
    </serviceTask>
    <serviceTask id="Task_VerifikasiBayar" name="Memverifikasi setoran awal">
      <incoming>F14</incoming>
      <outgoing>F15</outgoing>
    </serviceTask>
    <userTask id="Task_TerimaKartu" name="Menerima kartu anggota dan bukti setoran">
      <incoming>F16</incoming>
      <outgoing>F17</outgoing>
    </userTask>
    <endEvent id="End_Aktif" name="Anggota aktif">
      <incoming>F17</incoming>
    </endEvent>
    <intermediateCatchEvent id="Evt_BatasLewat" name="Batas pembayaran lewat">
      <incoming>F13b</incoming>
      <outgoing>F18</outgoing>
      <timerEventDefinition />
    </intermediateCatchEvent>
    <endEvent id="End_Kedaluwarsa" name="Pendaftaran kedaluwarsa">
      <incoming>F18</incoming>
    </endEvent>
  </process>
  <bpmndi:BPMNDiagram id="Diagram_Proc_ToBe_ManajemenAnggota">
