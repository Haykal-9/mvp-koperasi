<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Proc_ToBe_Simpanan" targetNamespace="http://smartcoop.id/bpmn/revisi" exporter="Camunda Modeler" exporterVersion="5.47.0">
  <documentation>Revisi BPMN To-Be: proses simpanan bulanan dengan reminder, verifikasi pembayaran, saldo real-time, jurnal otomatis, dan monitoring tunggakan.</documentation>
  <collaboration id="Collab_ToBe_Simpanan">
    <participant id="Participant_ToBe_Simpanan" name="SmartCoop - To-Be Simpanan" processRef="Proc_ToBe_Simpanan" />
  </collaboration>
  <process id="Proc_ToBe_Simpanan" isExecutable="false">
    <documentation>Revisi BPMN To-Be: proses simpanan bulanan dengan reminder, verifikasi pembayaran, saldo real-time, jurnal otomatis, dan monitoring tunggakan.</documentation>
    <laneSet id="LaneSet_Proc_ToBe_Simpanan">
      <lane id="Lane_4_SmartCoop" name="SmartCoop">
        <flowNodeRef>Start_Periode</flowNodeRef>
        <flowNodeRef>Task_DaftarKewajiban</flowNodeRef>
        <flowNodeRef>Task_Reminder</flowNodeRef>
        <flowNodeRef>PG_JoinCatat</flowNodeRef>
        <flowNodeRef>Task_Bukti</flowNodeRef>
        <flowNodeRef>GW_Tunggu</flowNodeRef>
        <flowNodeRef>Task_Verifikasi</flowNodeRef>
        <flowNodeRef>Task_Tunggakan</flowNodeRef>
        <flowNodeRef>GW_Sesuai</flowNodeRef>
        <flowNodeRef>PG_Catat</flowNodeRef>
        <flowNodeRef>Task_UpdateSaldo</flowNodeRef>
        <flowNodeRef>Task_Perbaikan</flowNodeRef>
        <flowNodeRef>Evt_Pembayaran</flowNodeRef>
      </lane>
      <lane id="Lane_3_Pengurus" name="Pengurus">
        <flowNodeRef>End_Tunggakan</flowNodeRef>
        <flowNodeRef>Task_TindakLanjut</flowNodeRef>
        <flowNodeRef>Evt_JatuhTempo</flowNodeRef>
      </lane>
      <lane id="Lane_2_Kasir_Keuangan" name="Kasir / Keuangan">
        <flowNodeRef>Task_Jurnal</flowNodeRef>
      </lane>
      <lane id="Lane_1_Anggota" name="Anggota">
        <flowNodeRef>Task_Bayar</flowNodeRef>
        <flowNodeRef>End_Sukses</flowNodeRef>
        <flowNodeRef>End_Perbaikan</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_Periode" name="Periode simpanan bulanan dimulai">
      <outgoing>F1</outgoing>
      <timerEventDefinition />
    </startEvent>
    <serviceTask id="Task_DaftarKewajiban" name="Membuat daftar kewajiban simpanan">
      <incoming>F1</incoming>
      <outgoing>F2</outgoing>
    </serviceTask>
    <sendTask id="Task_Reminder" name="Mengirim pengingat pembayaran">
      <incoming>F2</incoming>
      <outgoing>F3</outgoing>
    </sendTask>
    <sendTask id="Task_Bukti" name="Mengirim bukti setor digital">
      <incoming>F13a</incoming>
      <outgoing>F13</outgoing>
    </sendTask>
    <userTask id="Task_Bayar" name="Membayar simpanan via kanal yang tersedia">
      <incoming>F3</incoming>
      <outgoing>F4</outgoing>
    </userTask>
    <sequenceFlow id="F1" sourceRef="Start_Periode" targetRef="Task_DaftarKewajiban" />
    <sequenceFlow id="F2" sourceRef="Task_DaftarKewajiban" targetRef="Task_Reminder" />
    <sequenceFlow id="F3" sourceRef="Task_Reminder" targetRef="Task_Bayar" />
    <sequenceFlow id="F4" sourceRef="Task_Bayar" targetRef="GW_Tunggu" />
    <sequenceFlow id="F5a" name="Dibayar" sourceRef="GW_Tunggu" targetRef="Evt_Pembayaran" />
    <sequenceFlow id="F5b" name="Lewat tempo" sourceRef="GW_Tunggu" targetRef="Evt_JatuhTempo" />
    <sequenceFlow id="F6" sourceRef="Evt_Pembayaran" targetRef="Task_Tunggakan" />
    <sequenceFlow id="F7" sourceRef="Task_Verifikasi" targetRef="GW_Sesuai" />
    <sequenceFlow id="F8_Tidak" name="Tidak" sourceRef="GW_Sesuai" targetRef="Task_Perbaikan" />
    <sequenceFlow id="F10_Ya" name="Ya" sourceRef="GW_Sesuai" targetRef="PG_Catat" />
    <sequenceFlow id="F9" sourceRef="Task_Perbaikan" targetRef="End_Perbaikan" />
    <sequenceFlow id="F11a" sourceRef="PG_Catat" targetRef="Task_UpdateSaldo" />
    <sequenceFlow id="F11b" sourceRef="PG_Catat" targetRef="Task_Jurnal" />
    <sequenceFlow id="F12a" sourceRef="Task_UpdateSaldo" targetRef="PG_JoinCatat" />
    <sequenceFlow id="F12b" sourceRef="Task_Jurnal" targetRef="PG_JoinCatat" />
    <sequenceFlow id="F13a" sourceRef="PG_JoinCatat" targetRef="Task_Bukti" />
    <sequenceFlow id="F13" sourceRef="Task_Bukti" targetRef="End_Sukses" />
    <sequenceFlow id="F14" sourceRef="Evt_JatuhTempo" targetRef="Task_Tunggakan" />
    <sequenceFlow id="F15" sourceRef="Task_Tunggakan" targetRef="Task_TindakLanjut" />
    <eventBasedGateway id="GW_Tunggu" name="Menunggu pembayaran atau jatuh tempo">
      <incoming>F4</incoming>
      <outgoing>F5a</outgoing>
      <outgoing>F5b</outgoing>
    </eventBasedGateway>
    <sequenceFlow id="Flow_11342ub" sourceRef="Task_Tunggakan" targetRef="Task_Verifikasi" />
    <serviceTask id="Task_Verifikasi" name="Memverifikasi nominal dan identitas anggota">
      <incoming>Flow_11342ub</incoming>
      <outgoing>F7</outgoing>
    </serviceTask>
    <serviceTask id="Task_Tunggakan" name="Mencatat tunggakan dan mengirim teguran">
      <incoming>F14</incoming>
      <incoming>F6</incoming>
      <outgoing>F15</outgoing>
      <outgoing>Flow_11342ub</outgoing>
    </serviceTask>
    <exclusiveGateway id="GW_Sesuai" name="Pembayaran sesuai?">
      <incoming>F7</incoming>
      <outgoing>F8_Tidak</outgoing>
      <outgoing>F10_Ya</outgoing>
    </exclusiveGateway>
    <parallelGateway id="PG_Catat">
      <incoming>F10_Ya</incoming>
      <outgoing>F11a</outgoing>
      <outgoing>F11b</outgoing>
    </parallelGateway>
    <serviceTask id="Task_UpdateSaldo" name="Memperbarui saldo simpanan anggota">
      <incoming>F11a</incoming>
      <outgoing>F12a</outgoing>
    </serviceTask>
    <serviceTask id="Task_Jurnal" name="Mencatat jurnal simpanan">
      <incoming>F11b</incoming>
      <outgoing>F12b</outgoing>
    </serviceTask>
    <sendTask id="Task_Perbaikan" name="Meminta koreksi pembayaran">
      <incoming>F8_Tidak</incoming>
      <outgoing>F9</outgoing>
    </sendTask>
    <parallelGateway id="PG_JoinCatat">
      <incoming>F12a</incoming>
      <incoming>F12b</incoming>
      <outgoing>F13a</outgoing>
    </parallelGateway>
    <endEvent id="End_Sukses" name="Saldo diperbarui real-time">
      <incoming>F13</incoming>
    </endEvent>
    <endEvent id="End_Tunggakan" name="Tunggakan termonitor">
      <incoming>F16</incoming>
    </endEvent>
    <userTask id="Task_TindakLanjut" name="Menindaklanjuti sesuai AD/ART">
      <incoming>F15</incoming>
      <outgoing>F16</outgoing>
    </userTask>
    <sequenceFlow id="F16" sourceRef="Task_TindakLanjut" targetRef="End_Tunggakan" />
    <intermediateCatchEvent id="Evt_JatuhTempo" name="Jatuh tempo terlewati">
      <incoming>F5b</incoming>
      <outgoing>F14</outgoing>
      <timerEventDefinition />
    </intermediateCatchEvent>
    <intermediateCatchEvent id="Evt_Pembayaran" name="Pembayaran masuk">
      <incoming>F5a</incoming>
      <outgoing>F6</outgoing>
      <messageEventDefinition />
    </intermediateCatchEvent>
    <endEvent id="End_Perbaikan" name="Menunggu koreksi anggota">
      <incoming>F9</incoming>
    </endEvent>
  </process>
  <bpmndi:BPMNDiagram id="Diagram_Proc_ToBe_Simpanan">
    <bpmndi:BPMNPlane id="Plane_Proc_ToBe_Simpanan" bpmnElement="Collab_ToBe_Simpanan">
