<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://koperasi.id/bpmn"
             id="ToBe_Pinjaman">
  <collaboration id="Collab_1">
    <participant id="Pool_1" name="KSP Koperasi — Pinjaman (To-Be)" processRef="Proc_1"/>
  </collaboration>
  <process id="Proc_1" isExecutable="false">
    <laneSet id="LS_1">
      <lane id="Lane_Anggota" name="Anggota (Flutter App)">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>Task_IsiFormFlutter</flowNodeRef>
        <flowNodeRef>Task_TerimaNotifTolakAwal</flowNodeRef>
        <flowNodeRef>Task_TerimaNotifApprove</flowNodeRef>
        <flowNodeRef>Task_SetujuDigital</flowNodeRef>
        <flowNodeRef>Task_HadirTTDFisik</flowNodeRef>
        <flowNodeRef>Task_PantauAngsuranRT</flowNodeRef>
        <flowNodeRef>End_Cair</flowNodeRef>
        <flowNodeRef>End_TolakAwal</flowNodeRef>
        <flowNodeRef>End_TolakOwner</flowNodeRef>
      </lane>
      <lane id="Lane_GoBackend" name="Go Backend (Credit Scoring Otomatis)">
        <flowNodeRef>Task_CreditScoring</flowNodeRef>
        <flowNodeRef>GW_LolosSkor</flowNodeRef>
        <flowNodeRef>Task_NotifTolakAwal</flowNodeRef>
        <flowNodeRef>Task_BuatAkadDigital</flowNodeRef>
        <flowNodeRef>Task_NotifApprove</flowNodeRef>
        <flowNodeRef>Task_ProsesCairan</flowNodeRef>
        <flowNodeRef>Task_JadwalAngsuran</flowNodeRef>
      </lane>
      <lane id="Lane_Owner" name="Owner (Backoffice Vue.js)">
        <flowNodeRef>Task_ReviewOwner</flowNodeRef>
        <flowNodeRef>GW_ApproveOwner</flowNodeRef>
        <flowNodeRef>Task_NotifTolakOwner</flowNodeRef>
      </lane>
      <lane id="Lane_Kasir" name="Kasir (Backoffice Vue.js)">
        <flowNodeRef>Task_KoordinasiJadwal</flowNodeRef>
        <flowNodeRef>Task_TombolCairkan</flowNodeRef>
      </lane>
      <lane id="Lane_Payroll" name="Sistem Payroll">
        <flowNodeRef>Task_AktifAngsuran</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="Anggota butuh pinjaman"><outgoing>F1</outgoing></startEvent>
    <userTask id="Task_IsiFormFlutter" name="Isi form pengajuan di Flutter app (nominal, tenor, tujuan)"><incoming>F1</incoming><outgoing>F2</outgoing></userTask>
    <serviceTask id="Task_CreditScoring" name="Go Backend: credit scoring otomatis (cek simpanan, tunggakan, limit maks 3x simpanan)"><incoming>F2</incoming><outgoing>F3</outgoing></serviceTask>
    <exclusiveGateway id="GW_LolosSkor" name="Lolos credit scoring?"><incoming>F3</incoming><outgoing>F_TolakAwal</outgoing><outgoing>F_Lolos</outgoing></exclusiveGateway>
    <serviceTask id="Task_NotifTolakAwal" name="Kirim notifikasi penolakan otomatis + alasan ke Flutter app Anggota"><incoming>F_TolakAwal</incoming><outgoing>F4</outgoing></serviceTask>
    <userTask id="Task_TerimaNotifTolakAwal" name="Anggota terima notifikasi penolakan awal di Flutter app"><incoming>F4</incoming><outgoing>F_EndTolakAwal</outgoing></userTask>
    <endEvent id="End_TolakAwal" name="Pengajuan tidak lolos validasi sistem"><incoming>F_EndTolakAwal</incoming></endEvent>
    <userTask id="Task_ReviewOwner" name="Owner review detail pengajuan di dasbor backoffice Vue.js"><incoming>F_Lolos</incoming><outgoing>F5</outgoing></userTask>
    <exclusiveGateway id="GW_ApproveOwner" name="Owner approve?"><incoming>F5</incoming><outgoing>F_TolakOwner</outgoing><outgoing>F_Approve</outgoing></exclusiveGateway>
    <serviceTask id="Task_NotifTolakOwner" name="Kirim notifikasi penolakan Owner + alasan ke Flutter app Anggota"><incoming>F_TolakOwner</incoming><outgoing>F_EndTolakOwner</outgoing></serviceTask>
    <endEvent id="End_TolakOwner" name="Pengajuan ditolak Owner"><incoming>F_EndTolakOwner</incoming></endEvent>
    <serviceTask id="Task_BuatAkadDigital" name="Go Backend generate dokumen akad kredit digital"><incoming>F_Approve</incoming><outgoing>F6</outgoing></serviceTask>
    <serviceTask id="Task_NotifApprove" name="Kirim push notification FCM + akad digital ke Flutter app Anggota"><incoming>F6</incoming><outgoing>F7</outgoing></serviceTask>
    <userTask id="Task_TerimaNotifApprove" name="Anggota terima notifikasi persetujuan di Flutter app"><incoming>F7</incoming><outgoing>F8</outgoing></userTask>
    <userTask id="Task_SetujuDigital" name="Anggota baca akad digital dan klik Setuju / input PIN di Flutter app"><incoming>F8</incoming><outgoing>F9</outgoing></userTask>
    <userTask id="Task_KoordinasiJadwal" name="Kasir koordinasikan jadwal TTD fisik via fitur pengumuman sistem"><incoming>F9</incoming><outgoing>F10</outgoing></userTask>
    <userTask id="Task_HadirTTDFisik" name="Anggota hadir fisik TTD akad kredit (materai untuk pinjaman di atas Rp5 juta)"><incoming>F10</incoming><outgoing>F11</outgoing></userTask>
    <userTask id="Task_TombolCairkan" name="Kasir klik tombol Cairkan di dasbor backoffice Vue.js"><incoming>F11</incoming><outgoing>F12</outgoing></userTask>
    <serviceTask id="Task_ProsesCairan" name="Go Backend proses transfer dana ke rekening/dompet Anggota otomatis"><incoming>F12</incoming><outgoing>F13</outgoing></serviceTask>
    <serviceTask id="Task_JadwalAngsuran" name="Go Backend buat jadwal angsuran bulanan otomatis"><incoming>F13</incoming><outgoing>F14</outgoing></serviceTask>
    <serviceTask id="Task_AktifAngsuran" name="Aktifkan pemotongan angsuran via payroll (tenor maks 5 tahun)"><incoming>F14</incoming><outgoing>F15</outgoing></serviceTask>
    <userTask id="Task_PantauAngsuranRT" name="Anggota pantau sisa angsuran di Flutter app (saldo real-time)"><incoming>F15</incoming><outgoing>F16</outgoing></userTask>
    <endEvent id="End_Cair" name="Dana cair, angsuran terpantau real-time di Flutter app"><incoming>F16</incoming></endEvent>
    <sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_IsiFormFlutter"/>
    <sequenceFlow id="F2" sourceRef="Task_IsiFormFlutter" targetRef="Task_CreditScoring"/>
    <sequenceFlow id="F3" sourceRef="Task_CreditScoring" targetRef="GW_LolosSkor"/>
    <sequenceFlow id="F_TolakAwal" name="Tidak lolos" sourceRef="GW_LolosSkor" targetRef="Task_NotifTolakAwal"/>
    <sequenceFlow id="F4" sourceRef="Task_NotifTolakAwal" targetRef="Task_TerimaNotifTolakAwal"/>
    <sequenceFlow id="F_EndTolakAwal" sourceRef="Task_TerimaNotifTolakAwal" targetRef="End_TolakAwal"/>
    <sequenceFlow id="F_Lolos" name="Lolos" sourceRef="GW_LolosSkor" targetRef="Task_ReviewOwner"/>
    <sequenceFlow id="F5" sourceRef="Task_ReviewOwner" targetRef="GW_ApproveOwner"/>
    <sequenceFlow id="F_TolakOwner" name="Tolak" sourceRef="GW_ApproveOwner" targetRef="Task_NotifTolakOwner"/>
    <sequenceFlow id="F_EndTolakOwner" sourceRef="Task_NotifTolakOwner" targetRef="End_TolakOwner"/>
    <sequenceFlow id="F_Approve" name="Approve" sourceRef="GW_ApproveOwner" targetRef="Task_BuatAkadDigital"/>
    <sequenceFlow id="F6" sourceRef="Task_BuatAkadDigital" targetRef="Task_NotifApprove"/>
    <sequenceFlow id="F7" sourceRef="Task_NotifApprove" targetRef="Task_TerimaNotifApprove"/>
    <sequenceFlow id="F8" sourceRef="Task_TerimaNotifApprove" targetRef="Task_SetujuDigital"/>
    <sequenceFlow id="F9" sourceRef="Task_SetujuDigital" targetRef="Task_KoordinasiJadwal"/>
    <sequenceFlow id="F10" sourceRef="Task_KoordinasiJadwal" targetRef="Task_HadirTTDFisik"/>
    <sequenceFlow id="F11" sourceRef="Task_HadirTTDFisik" targetRef="Task_TombolCairkan"/>
    <sequenceFlow id="F12" sourceRef="Task_TombolCairkan" targetRef="Task_ProsesCairan"/>
    <sequenceFlow id="F13" sourceRef="Task_ProsesCairan" targetRef="Task_JadwalAngsuran"/>
    <sequenceFlow id="F14" sourceRef="Task_JadwalAngsuran" targetRef="Task_AktifAngsuran"/>
    <sequenceFlow id="F15" sourceRef="Task_AktifAngsuran" targetRef="Task_PantauAngsuranRT"/>
    <sequenceFlow id="F16" sourceRef="Task_PantauAngsuranRT" targetRef="End_Cair"/>
  </process>
  <bpmndi:BPMNDiagram id="Diag_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collab_1">
      <bpmndi:BPMNShape id="Pool_1_di" bpmnElement="Pool_1" isHorizontal="true"><dc:Bounds x="80" y="50" width="1600" height="680"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Anggota_di" bpmnElement="Lane_Anggota" isHorizontal="true"><dc:Bounds x="110" y="50" width="1570" height="140"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_GoBackend_di" bpmnElement="Lane_GoBackend" isHorizontal="true"><dc:Bounds x="110" y="190" width="1570" height="140"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Owner_di" bpmnElement="Lane_Owner" isHorizontal="true"><dc:Bounds x="110" y="330" width="1570" height="130"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Kasir_di" bpmnElement="Lane_Kasir" isHorizontal="true"><dc:Bounds x="110" y="460" width="1570" height="110"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Payroll_di" bpmnElement="Lane_Payroll" isHorizontal="true"><dc:Bounds x="110" y="570" width="1570" height="160"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1"><dc:Bounds x="142" y="102" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_IsiFormFlutter_di" bpmnElement="Task_IsiFormFlutter"><dc:Bounds x="220" y="82" width="120" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreditScoring_di" bpmnElement="Task_CreditScoring"><dc:Bounds x="380" y="215" width="120" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_LolosSkor_di" bpmnElement="GW_LolosSkor" isMarkerVisible="true"><dc:Bounds x="550" y="228" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifTolakAwal_di" bpmnElement="Task_NotifTolakAwal"><dc:Bounds x="640" y="215" width="120" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TerimaNotifTolakAwal_di" bpmnElement="Task_TerimaNotifTolakAwal"><dc:Bounds x="640" y="82" width="120" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_TolakAwal_di" bpmnElement="End_TolakAwal"><dc:Bounds x="802" y="102" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReviewOwner_di" bpmnElement="Task_ReviewOwner"><dc:Bounds x="800" y="355" width="120" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_ApproveOwner_di" bpmnElement="GW_ApproveOwner" isMarkerVisible="true"><dc:Bounds x="970" y="368" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifTolakOwner_di" bpmnElement="Task_NotifTolakOwner"><dc:Bounds x="1060" y="215" width="120" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_TolakOwner_di" bpmnElement="End_TolakOwner"><dc:Bounds x="1222" y="235" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BuatAkadDigital_di" bpmnElement="Task_BuatAkadDigital"><dc:Bounds x="1100" y="355" width="120" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifApprove_di" bpmnElement="Task_NotifApprove"><dc:Bounds x="1260" y="215" width="120" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TerimaNotifApprove_di" bpmnElement="Task_TerimaNotifApprove"><dc:Bounds x="1260" y="82" width="120" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SetujuDigital_di" bpmnElement="Task_SetujuDigital"><dc:Bounds x="1420" y="82" width="120" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_KoordinasiJadwal_di" bpmnElement="Task_KoordinasiJadwal"><dc:Bounds x="1420" y="478" width="120" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_HadirTTDFisik_di" bpmnElement="Task_HadirTTDFisik"><dc:Bounds x="1560" y="82" width="120" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TombolCairkan_di" bpmnElement="Task_TombolCairkan"><dc:Bounds x="1560" y="478" width="120" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ProsesCairan_di" bpmnElement="Task_ProsesCairan"><dc:Bounds x="1560" y="215" width="120" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_JadwalAngsuran_di" bpmnElement="Task_JadwalAngsuran"><dc:Bounds x="1400" y="215" width="120" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AktifAngsuran_di" bpmnElement="Task_AktifAngsuran"><dc:Bounds x="1400" y="600" width="120" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PantauAngsuranRT_di" bpmnElement="Task_PantauAngsuranRT"><dc:Bounds x="1220" y="82" width="120" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Cair_di" bpmnElement="End_Cair"><dc:Bounds x="1102" y="102" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="178" y="120"/><di:waypoint x="220" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="280" y="157"/><di:waypoint x="440" y="215"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="500" y="253"/><di:waypoint x="550" y="253"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_TolakAwal_di" bpmnElement="F_TolakAwal"><di:waypoint x="600" y="253"/><di:waypoint x="640" y="253"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="700" y="215"/><di:waypoint x="700" y="157"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_EndTolakAwal_di" bpmnElement="F_EndTolakAwal"><di:waypoint x="760" y="120"/><di:waypoint x="802" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Lolos_di" bpmnElement="F_Lolos"><di:waypoint x="575" y="278"/><di:waypoint x="860" y="355"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="920" y="393"/><di:waypoint x="970" y="393"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_TolakOwner_di" bpmnElement="F_TolakOwner"><di:waypoint x="1020" y="393"/><di:waypoint x="1120" y="290"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_EndTolakOwner_di" bpmnElement="F_EndTolakOwner"><di:waypoint x="1180" y="253"/><di:waypoint x="1222" y="253"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Approve_di" bpmnElement="F_Approve"><di:waypoint x="1020" y="393"/><di:waypoint x="1160" y="430"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="1220" y="393"/><di:waypoint x="1320" y="290"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="1320" y="215"/><di:waypoint x="1320" y="157"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="1380" y="120"/><di:waypoint x="1420" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="1480" y="157"/><di:waypoint x="1480" y="478"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="1480" y="553"/><di:waypoint x="1620" y="157"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11"><di:waypoint x="1620" y="157"/><di:waypoint x="1620" y="478"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F12_di" bpmnElement="F12"><di:waypoint x="1620" y="553"/><di:waypoint x="1620" y="290"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F13_di" bpmnElement="F13"><di:waypoint x="1560" y="253"/><di:waypoint x="1520" y="253"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F14_di" bpmnElement="F14"><di:waypoint x="1460" y="290"/><di:waypoint x="1460" y="600"/></bpmndi:BPMNEdge>
