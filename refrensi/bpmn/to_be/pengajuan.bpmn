<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Proc_ToBe_Pengajuan" targetNamespace="http://smartcoop.id/bpmn/revisi" exporter="Camunda Modeler" exporterVersion="5.47.0">
  <documentation>Revisi BPMN To-Be: proses pinjaman digital dari pengajuan, penilaian kelayakan, akad, pencairan, jadwal angsuran, sampai pencatatan jurnal.</documentation>
  <collaboration id="Collab_ToBe_Pengajuan">
    <participant id="Participant_ToBe_Pengajuan" name="SmartCoop - To-Be Pengajuan Pinjaman" processRef="Proc_ToBe_Pengajuan" />
  </collaboration>
  <process id="Proc_ToBe_Pengajuan" isExecutable="false">
    <documentation>Revisi BPMN To-Be: proses pinjaman digital dari pengajuan, penilaian kelayakan, akad, pencairan, jadwal angsuran, sampai pencatatan jurnal.</documentation>
    <laneSet id="LaneSet_Proc_ToBe_Pengajuan">
      <lane id="Lane_4_SmartCoop" name="SmartCoop">
        <flowNodeRef>Task_Ringkasan</flowNodeRef>
        <flowNodeRef>IG_Pemeriksaan</flowNodeRef>
        <flowNodeRef>Task_CekKewajiban</flowNodeRef>
        <flowNodeRef>IG_Gabung</flowNodeRef>
        <flowNodeRef>Task_InfoTolak</flowNodeRef>
        <flowNodeRef>Evt_TidakHadir</flowNodeRef>
        <flowNodeRef>PG_PascaCair</flowNodeRef>
        <flowNodeRef>Task_JadwalAngsuran</flowNodeRef>
        <flowNodeRef>PG_JoinPascaCair</flowNodeRef>
        <flowNodeRef>Task_NotifAktif</flowNodeRef>
        <flowNodeRef>Task_JadwalAkad</flowNodeRef>
        <flowNodeRef>GW_Akad</flowNodeRef>
      </lane>
      <lane id="Lane_3_Pengurus" name="Pengurus">
        <flowNodeRef>Task_Nilai</flowNodeRef>
        <flowNodeRef>GW_Putus</flowNodeRef>
      </lane>
      <lane id="Lane_2_Kasir_Keuangan" name="Kasir / Keuangan">
        <flowNodeRef>Task_Cairkan</flowNodeRef>
        <flowNodeRef>Task_Jurnal</flowNodeRef>
      </lane>
      <lane id="Lane_1_Anggota" name="Anggota">
        <flowNodeRef>Start_Pinjaman</flowNodeRef>
        <flowNodeRef>Task_AjukanDigital</flowNodeRef>
        <flowNodeRef>Task_Lengkapi</flowNodeRef>
        <flowNodeRef>End_Tolak</flowNodeRef>
        <flowNodeRef>End_BatalAkad</flowNodeRef>
        <flowNodeRef>Evt_AkadMasuk</flowNodeRef>
        <flowNodeRef>End_Aktif</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_Pinjaman" name="Anggota membutuhkan pinjaman">
      <outgoing>F1</outgoing>
    </startEvent>
    <userTask id="Task_AjukanDigital" name="Mengisi pengajuan pinjaman digital">
      <incoming>F1</incoming>
      <outgoing>F2</outgoing>
    </userTask>
    <businessRuleTask id="Task_Ringkasan" name="Menyiapkan simulasi angsuran dan ringkasan kelayakan">
      <incoming>F2</incoming>
      <outgoing>F3</outgoing>
    </businessRuleTask>
    <inclusiveGateway id="IG_Pemeriksaan" name="Pemeriksaan yang diperlukan">
      <incoming>F3</incoming>
      <outgoing>F4a</outgoing>
      <outgoing>F4b</outgoing>
      <outgoing>F4c</outgoing>
    </inclusiveGateway>
    <sequenceFlow id="F1" sourceRef="Start_Pinjaman" targetRef="Task_AjukanDigital" />
    <sequenceFlow id="F2" sourceRef="Task_AjukanDigital" targetRef="Task_Ringkasan" />
    <sequenceFlow id="F4a" name="Riwayat kewajiban" sourceRef="IG_Pemeriksaan" targetRef="Task_CekKewajiban" />
    <sequenceFlow id="F5a" sourceRef="Task_CekKewajiban" targetRef="IG_Gabung" />
    <sequenceFlow id="F4b" name="Keputusan pengurus" sourceRef="IG_Pemeriksaan" targetRef="Task_Nilai" />
    <sequenceFlow id="F5b" sourceRef="Task_Nilai" targetRef="IG_Gabung" />
    <sequenceFlow id="F5c" sourceRef="Task_Lengkapi" targetRef="IG_Gabung" />
    <sequenceFlow id="F6" sourceRef="IG_Gabung" targetRef="GW_Putus" />
    <sequenceFlow id="F7_Tidak" name="Tidak" sourceRef="GW_Putus" targetRef="Task_InfoTolak" />
    <sequenceFlow id="F9_Ya" name="Ya" sourceRef="GW_Putus" targetRef="Task_JadwalAkad" />
    <sequenceFlow id="F8" sourceRef="Task_InfoTolak" targetRef="End_Tolak" />
    <sequenceFlow id="F10" sourceRef="Task_JadwalAkad" targetRef="GW_Akad" />
    <sequenceFlow id="F11a" name="Akad diterima" sourceRef="GW_Akad" targetRef="Evt_AkadMasuk" />
    <sequenceFlow id="F11b" name="Lewat jadwal" sourceRef="GW_Akad" targetRef="Evt_TidakHadir" />
    <sequenceFlow id="F12" sourceRef="Evt_AkadMasuk" targetRef="Task_Cairkan" />
    <sequenceFlow id="F17" sourceRef="Evt_TidakHadir" targetRef="End_BatalAkad" />
    <sequenceFlow id="F13" sourceRef="Task_Cairkan" targetRef="PG_PascaCair" />
    <sequenceFlow id="F14a" sourceRef="PG_PascaCair" targetRef="Task_JadwalAngsuran" />
    <sequenceFlow id="F14b" sourceRef="PG_PascaCair" targetRef="Task_Jurnal" />
    <sequenceFlow id="F15a" sourceRef="Task_JadwalAngsuran" targetRef="PG_JoinPascaCair" />
    <sequenceFlow id="F15b" sourceRef="Task_Jurnal" targetRef="PG_JoinPascaCair" />
    <sequenceFlow id="F15c" sourceRef="PG_JoinPascaCair" targetRef="Task_NotifAktif" />
    <sequenceFlow id="F16" sourceRef="Task_NotifAktif" targetRef="End_Aktif" />
    <sequenceFlow id="F3" sourceRef="Task_Ringkasan" targetRef="IG_Pemeriksaan" />
    <sequenceFlow id="F4c" name="Dokumen tambahan" sourceRef="IG_Pemeriksaan" targetRef="Task_Lengkapi" />
    <userTask id="Task_Lengkapi" name="Melengkapi dokumen pendukung bila diminta">
      <incoming>F4c</incoming>
      <outgoing>F5c</outgoing>
    </userTask>
    <userTask id="Task_Nilai" name="Menilai kemampuan bayar dan tujuan pinjaman">
      <incoming>F4b</incoming>
      <outgoing>F5b</outgoing>
    </userTask>
    <serviceTask id="Task_CekKewajiban" name="Mengecek simpanan, pinjaman aktif, dan tunggakan">
      <incoming>F4a</incoming>
      <outgoing>F5a</outgoing>
    </serviceTask>
    <inclusiveGateway id="IG_Gabung">
      <incoming>F5a</incoming>
      <incoming>F5b</incoming>
      <incoming>F5c</incoming>
      <outgoing>F6</outgoing>
    </inclusiveGateway>
    <exclusiveGateway id="GW_Putus" name="Pinjaman disetujui?">
      <incoming>F6</incoming>
      <outgoing>F7_Tidak</outgoing>
      <outgoing>F9_Ya</outgoing>
    </exclusiveGateway>
    <sendTask id="Task_InfoTolak" name="Menyampaikan keputusan penolakan atau revisi">
      <incoming>F7_Tidak</incoming>
      <outgoing>F8</outgoing>
    </sendTask>
    <endEvent id="End_Tolak" name="Pengajuan tidak dilanjutkan">
      <incoming>F8</incoming>
    </endEvent>
    <intermediateCatchEvent id="Evt_TidakHadir" name="Jadwal akad terlewati">
      <incoming>F11b</incoming>
      <outgoing>F17</outgoing>
      <timerEventDefinition />
    </intermediateCatchEvent>
    <endEvent id="End_BatalAkad" name="Pengajuan menunggu jadwal ulang">
      <incoming>F17</incoming>
    </endEvent>
    <intermediateCatchEvent id="Evt_AkadMasuk" name="Akad ditandatangani">
      <incoming>F11a</incoming>
      <outgoing>F12</outgoing>
      <messageEventDefinition />
    </intermediateCatchEvent>
    <userTask id="Task_Cairkan" name="Mencairkan dana pinjaman">
      <incoming>F12</incoming>
      <outgoing>F13</outgoing>
    </userTask>
    <parallelGateway id="PG_PascaCair">
      <incoming>F13</incoming>
      <outgoing>F14a</outgoing>
      <outgoing>F14b</outgoing>
    </parallelGateway>
    <serviceTask id="Task_JadwalAngsuran" name="Membuat jadwal angsuran">
      <incoming>F14a</incoming>
      <outgoing>F15a</outgoing>
    </serviceTask>
    <serviceTask id="Task_Jurnal" name="Mencatat jurnal pinjaman">
      <incoming>F14b</incoming>
      <outgoing>F15b</outgoing>
    </serviceTask>
    <parallelGateway id="PG_JoinPascaCair">
      <incoming>F15a</incoming>
      <incoming>F15b</incoming>
      <outgoing>F15c</outgoing>
    </parallelGateway>
    <sendTask id="Task_NotifAktif" name="Mengirim bukti pencairan dan jadwal angsuran">
      <incoming>F15c</incoming>
      <outgoing>F16</outgoing>
    </sendTask>
    <endEvent id="End_Aktif" name="Pinjaman aktif">
      <incoming>F16</incoming>
    </endEvent>
    <sendTask id="Task_JadwalAkad" name="Mengirim jadwal akad dan pencairan">
      <incoming>F9_Ya</incoming>
      <outgoing>F10</outgoing>
    </sendTask>
    <eventBasedGateway id="GW_Akad" name="Menunggu akad">
      <incoming>F10</incoming>
      <outgoing>F11a</outgoing>
      <outgoing>F11b</outgoing>
    </eventBasedGateway>
  </process>
