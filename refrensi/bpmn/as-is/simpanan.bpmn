<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Proc_AsIs_Simpanan" targetNamespace="http://smartcoop.id/bpmn/revisi" exporter="Camunda Modeler" exporterVersion="5.47.0">
  <documentation>Revisi BPMN As-Is: proses bisnis pembayaran simpanan dengan pencatatan dan pembaruan saldo periodik.</documentation>
  <collaboration id="Collab_AsIs_Simpanan">
    <participant id="Participant_AsIs_Simpanan" name="Koperasi Simpan Pinjam - As-Is Simpanan" processRef="Proc_AsIs_Simpanan" />
  </collaboration>
  <process id="Proc_AsIs_Simpanan" isExecutable="false">
    <documentation>Revisi BPMN As-Is: proses bisnis pembayaran simpanan dengan pencatatan dan pembaruan saldo periodik.</documentation>
    <laneSet id="LaneSet_Proc_AsIs_Simpanan">
      <lane id="Lane_4_Pembukuan_Utama_Aplikasi_Ang" name="Pembukuan Utama &#38; Aplikasi Anggota">
        <flowNodeRef>Start_JatuhTempo</flowNodeRef>
        <flowNodeRef>Task_RekapBulanan</flowNodeRef>
        <flowNodeRef>Task_UpdateAplikasi</flowNodeRef>
        <flowNodeRef>Evt_AwalBulan</flowNodeRef>
      </lane>
      <lane id="Lane_3_Pengurus" name="Pengurus">
        <flowNodeRef>Evt_Terlambat</flowNodeRef>
        <flowNodeRef>Task_Tegur</flowNodeRef>
        <flowNodeRef>End_Tunggakan</flowNodeRef>
      </lane>
      <lane id="Lane_2_Kasir_Keuangan" name="Kasir / Keuangan">
        <flowNodeRef>Task_SiapkanDaftar</flowNodeRef>
        <flowNodeRef>GW_Tunggu</flowNodeRef>
        <flowNodeRef>Evt_BuktiMasuk</flowNodeRef>
        <flowNodeRef>Task_CatatManual</flowNodeRef>
      </lane>
      <lane id="Lane_1_Anggota" name="Anggota">
        <flowNodeRef>Task_Bayar</flowNodeRef>
        <flowNodeRef>End_Saldo</flowNodeRef>
      </lane>
    </laneSet>
    <sequenceFlow id="F1" sourceRef="Start_JatuhTempo" targetRef="Task_SiapkanDaftar" />
    <sequenceFlow id="F6" sourceRef="Task_CatatManual" targetRef="Task_RekapBulanan" />
    <sequenceFlow id="F7" sourceRef="Task_RekapBulanan" targetRef="Evt_AwalBulan" />
    <sequenceFlow id="F9" sourceRef="Task_UpdateAplikasi" targetRef="End_Saldo" />
    <sequenceFlow id="F11" sourceRef="Task_Tegur" targetRef="End_Tunggakan" />
    <manualTask id="Task_Bayar" name="Membayar simpanan wajib atau sukarela">
      <incoming>F2</incoming>
      <outgoing>F3</outgoing>
    </manualTask>
    <manualTask id="Task_SiapkanDaftar" name="Menyiapkan daftar kewajiban simpanan">
      <incoming>F1</incoming>
      <outgoing>F2</outgoing>
    </manualTask>
    <eventBasedGateway id="GW_Tunggu" name="Menunggu pembayaran atau batas waktu">
      <incoming>F3</incoming>
      <outgoing>F4a</outgoing>
      <outgoing>F4b</outgoing>
    </eventBasedGateway>
    <sequenceFlow id="F2" sourceRef="Task_SiapkanDaftar" targetRef="Task_Bayar" />
    <sequenceFlow id="F3" sourceRef="Task_Bayar" targetRef="GW_Tunggu" />
    <sequenceFlow id="F4a" name="Bayar" sourceRef="GW_Tunggu" targetRef="Evt_BuktiMasuk" />
    <sequenceFlow id="F4b" name="Lewat waktu" sourceRef="GW_Tunggu" targetRef="Evt_Terlambat" />
    <sequenceFlow id="F5" sourceRef="Evt_BuktiMasuk" targetRef="Task_CatatManual" />
    <sequenceFlow id="F10" sourceRef="Evt_Terlambat" targetRef="Task_Tegur" />
    <startEvent id="Start_JatuhTempo" name="Jadwal simpanan bulanan tiba">
      <outgoing>F1</outgoing>
      <timerEventDefinition />
    </startEvent>
    <intermediateCatchEvent id="Evt_Terlambat" name="Batas pembayaran terlewati">
      <incoming>F4b</incoming>
      <outgoing>F10</outgoing>
      <timerEventDefinition />
    </intermediateCatchEvent>
    <intermediateCatchEvent id="Evt_BuktiMasuk" name="Bukti pembayaran diterima">
      <incoming>F4a</incoming>
      <outgoing>F5</outgoing>
      <messageEventDefinition />
    </intermediateCatchEvent>
    <manualTask id="Task_CatatManual" name="Mencatat setoran pada pembukuan utama">
      <incoming>F5</incoming>
      <outgoing>F6</outgoing>
    </manualTask>
    <manualTask id="Task_Tegur" name="Menghubungi anggota yang belum setor">
      <incoming>F10</incoming>
      <outgoing>F11</outgoing>
    </manualTask>
    <endEvent id="End_Tunggakan" name="Tunggakan ditindaklanjuti">
      <incoming>F11</incoming>
    </endEvent>
    <manualTask id="Task_RekapBulanan" name="Merekap transaksi untuk pembaruan aplikasi">
      <incoming>F6</incoming>
      <outgoing>F7</outgoing>
    </manualTask>
    <manualTask id="Task_UpdateAplikasi" name="Memperbarui saldo anggota di aplikasi">
      <incoming>F8</incoming>
      <outgoing>F9</outgoing>
    </manualTask>
    <sequenceFlow id="F8" sourceRef="Evt_AwalBulan" targetRef="Task_UpdateAplikasi" />
    <endEvent id="End_Saldo" name="Informasi saldo diperbarui">
      <incoming>F9</incoming>
    </endEvent>
    <intermediateCatchEvent id="Evt_AwalBulan" name="Awal bulan berikutnya">
      <incoming>F7</incoming>
      <outgoing>F8</outgoing>
      <timerEventDefinition />
    </intermediateCatchEvent>
  </process>
  <bpmndi:BPMNDiagram id="Diagram_Proc_AsIs_Simpanan">
    <bpmndi:BPMNPlane id="Plane_Proc_AsIs_Simpanan" bpmnElement="Collab_AsIs_Simpanan">
      <bpmndi:BPMNShape id="Participant_AsIs_Simpanan_di" bpmnElement="Participant_AsIs_Simpanan" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="1360" height="530" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
