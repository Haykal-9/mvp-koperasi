<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Proc_AsIs_SHU" targetNamespace="http://smartcoop.id/bpmn/revisi" exporter="Camunda Modeler" exporterVersion="5.47.0">
  <documentation>Revisi BPMN As-Is: proses pembagian SHU tahunan melalui rekap manual, RAT, dan pembayaran kepada anggota.</documentation>
  <collaboration id="Collab_AsIs_SHU">
    <participant id="Participant_AsIs_SHU" name="Koperasi Simpan Pinjam - As-Is SHU" processRef="Proc_AsIs_SHU" />
  </collaboration>
  <process id="Proc_AsIs_SHU" isExecutable="false">
    <documentation>Revisi BPMN As-Is: proses pembagian SHU tahunan melalui rekap manual, RAT, dan pembayaran kepada anggota.</documentation>
    <laneSet id="LaneSet_Proc_AsIs_SHU">
      <lane id="Lane_4_Pembukuan_Utama" name="Pembukuan Utama">
        <flowNodeRef>Start_TahunBuku</flowNodeRef>
        <flowNodeRef>Task_TutupBuku</flowNodeRef>
      </lane>
      <lane id="Lane_3_Pengurus" name="Pengurus">
        <flowNodeRef>PG_Split</flowNodeRef>
        <flowNodeRef>Task_SiapkanRAT</flowNodeRef>
        <flowNodeRef>PG_Join</flowNodeRef>
        <flowNodeRef>Task_Koreksi</flowNodeRef>
        <flowNodeRef>Task_Tetapkan</flowNodeRef>
      </lane>
      <lane id="Lane_2_Kasir_Keuangan" name="Kasir / Keuangan">
        <flowNodeRef>Task_KumpulRekap</flowNodeRef>
        <flowNodeRef>Task_HitungKontribusi</flowNodeRef>
        <flowNodeRef>Task_BayarSHU</flowNodeRef>
      </lane>
      <lane id="Lane_1_Anggota_RAT" name="Anggota / RAT">
        <flowNodeRef>Task_BahasRAT</flowNodeRef>
        <flowNodeRef>GW_SetujuRAT</flowNodeRef>
        <flowNodeRef>End_Selesai</flowNodeRef>
      </lane>
    </laneSet>
    <manualTask id="Task_KumpulRekap" name="Mengumpulkan rekap simpanan, pinjaman, dan usaha">
      <incoming>F1</incoming>
      <outgoing>F2</outgoing>
    </manualTask>
    <startEvent id="Start_TahunBuku" name="Akhir tahun buku">
      <outgoing>F1</outgoing>
      <timerEventDefinition />
    </startEvent>
    <parallelGateway id="PG_Split">
      <incoming>F3</incoming>
      <incoming>F9_Ulang</incoming>
      <outgoing>F4a</outgoing>
      <outgoing>F4b</outgoing>
    </parallelGateway>
    <manualTask id="Task_HitungKontribusi" name="Menghitung kontribusi anggota">
      <incoming>F4a</incoming>
      <outgoing>F5a</outgoing>
    </manualTask>
    <manualTask id="Task_SiapkanRAT" name="Menyiapkan bahan pembahasan RAT">
      <incoming>F4b</incoming>
      <outgoing>F5b</outgoing>
    </manualTask>
    <parallelGateway id="PG_Join">
      <incoming>F5a</incoming>
      <incoming>F5b</incoming>
      <outgoing>F6</outgoing>
    </parallelGateway>
    <manualTask id="Task_BahasRAT" name="Membahas rancangan pembagian SHU">
      <incoming>F6</incoming>
      <outgoing>F7</outgoing>
    </manualTask>
    <exclusiveGateway id="GW_SetujuRAT" name="RAT menyetujui?">
      <incoming>F7</incoming>
      <outgoing>F8_Tidak</outgoing>
      <outgoing>F10_Ya</outgoing>
    </exclusiveGateway>
    <manualTask id="Task_Koreksi" name="Melakukan koreksi perhitungan">
      <incoming>F8_Tidak</incoming>
      <outgoing>F9_Ulang</outgoing>
    </manualTask>
    <manualTask id="Task_Tetapkan" name="Menetapkan daftar SHU anggota">
      <incoming>F10_Ya</incoming>
      <outgoing>F11</outgoing>
    </manualTask>
    <manualTask id="Task_TutupBuku" name="Menutup pembukuan dan menghitung laba bersih">
      <incoming>F2</incoming>
      <outgoing>F3</outgoing>
    </manualTask>
    <sequenceFlow id="F1" sourceRef="Start_TahunBuku" targetRef="Task_KumpulRekap" />
    <sequenceFlow id="F2" sourceRef="Task_KumpulRekap" targetRef="Task_TutupBuku" />
    <sequenceFlow id="F3" sourceRef="Task_TutupBuku" targetRef="PG_Split" />
    <sequenceFlow id="F9_Ulang" name="Hitung ulang" sourceRef="Task_Koreksi" targetRef="PG_Split" />
    <sequenceFlow id="F4a" sourceRef="PG_Split" targetRef="Task_HitungKontribusi" />
    <sequenceFlow id="F4b" sourceRef="PG_Split" targetRef="Task_SiapkanRAT" />
    <sequenceFlow id="F5a" sourceRef="Task_HitungKontribusi" targetRef="PG_Join" />
    <sequenceFlow id="F5b" sourceRef="Task_SiapkanRAT" targetRef="PG_Join" />
    <sequenceFlow id="F6" sourceRef="PG_Join" targetRef="Task_BahasRAT" />
    <sequenceFlow id="F7" sourceRef="Task_BahasRAT" targetRef="GW_SetujuRAT" />
    <sequenceFlow id="F8_Tidak" name="Perlu revisi" sourceRef="GW_SetujuRAT" targetRef="Task_Koreksi" />
    <sequenceFlow id="F10_Ya" name="Disetujui" sourceRef="GW_SetujuRAT" targetRef="Task_Tetapkan" />
    <sequenceFlow id="F11" sourceRef="Task_Tetapkan" targetRef="Task_BayarSHU" />
    <manualTask id="Task_BayarSHU" name="Membayarkan atau mencatat SHU anggota">
      <incoming>F11</incoming>
      <outgoing>F12</outgoing>
    </manualTask>
    <endEvent id="End_Selesai" name="SHU dibagikan">
      <incoming>F12</incoming>
    </endEvent>
    <sequenceFlow id="F12" sourceRef="Task_BayarSHU" targetRef="End_Selesai" />
  </process>
  <bpmndi:BPMNDiagram id="Diagram_Proc_AsIs_SHU">
    <bpmndi:BPMNPlane id="Plane_Proc_AsIs_SHU" bpmnElement="Collab_AsIs_SHU">
      <bpmndi:BPMNShape id="Participant_AsIs_SHU_di" bpmnElement="Participant_AsIs_SHU" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="1830" height="550" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_4_Pembukuan_Utama_di" bpmnElement="Lane_4_Pembukuan_Utama" isHorizontal="true">
        <dc:Bounds x="196" y="480" width="1794" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_3_Pengurus_di" bpmnElement="Lane_3_Pengurus" isHorizontal="true">
