<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Proc_AsIs_ManajemenAnggota" targetNamespace="http://smartcoop.id/bpmn/revisi" exporter="Camunda Modeler" exporterVersion="5.47.0">
  <documentation>Revisi BPMN As-Is: proses bisnis pendaftaran anggota semi-manual, bukan alur halaman aplikasi.</documentation>
  <collaboration id="Collab_AsIs_ManajemenAnggota">
    <participant id="Participant_AsIs_ManajemenAnggota" name="Koperasi Simpan Pinjam - As-Is Manajemen Anggota" processRef="Proc_AsIs_ManajemenAnggota" />
  </collaboration>
  <process id="Proc_AsIs_ManajemenAnggota" isExecutable="false">
    <documentation>Revisi BPMN As-Is: proses bisnis pendaftaran anggota semi-manual, bukan alur halaman aplikasi.</documentation>
    <laneSet id="LaneSet_Proc_AsIs_ManajemenAnggota">
      <lane id="Lane_2_Kasir_Administrasi" name="Kasir / Administrasi">
        <flowNodeRef>Task_TerimaBerkas</flowNodeRef>
        <flowNodeRef>Task_BuatAkses</flowNodeRef>
      </lane>
      <lane id="Lane_1_Calon_Anggota" name="Calon Anggota">
        <flowNodeRef>Start_Daftar</flowNodeRef>
        <flowNodeRef>Task_IsiForm</flowNodeRef>
        <flowNodeRef>Task_SerahSetoran</flowNodeRef>
        <flowNodeRef>End_Tolak</flowNodeRef>
        <flowNodeRef>Task_TerimaAkses</flowNodeRef>
        <flowNodeRef>End_Aktif</flowNodeRef>
      </lane>
      <lane id="Lane_3_Pengurus" name="Pengurus">
        <flowNodeRef>Task_PeriksaKelayakan</flowNodeRef>
        <flowNodeRef>GW_Syarat</flowNodeRef>
        <flowNodeRef>Task_Tolak</flowNodeRef>
        <flowNodeRef>PG_Split</flowNodeRef>
        <flowNodeRef>PG_Join</flowNodeRef>
      </lane>
      <lane id="Lane_4_Pembukuan_Utama_Aplikasi_Ang" name="Pembukuan Utama &#38; Aplikasi Anggota">
        <flowNodeRef>Task_CatatPembukuan</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_Daftar" name="Calon anggota ingin bergabung">
      <outgoing>F1</outgoing>
    </startEvent>
    <manualTask id="Task_IsiForm" name="Mengisi formulir pendaftaran fisik">
      <incoming>F1</incoming>
      <outgoing>F2</outgoing>
    </manualTask>
    <manualTask id="Task_SerahSetoran" name="Menyerahkan formulir dan setoran awal">
      <incoming>F2</incoming>
      <outgoing>F3</outgoing>
    </manualTask>
    <manualTask id="Task_TerimaBerkas" name="Menerima dokumen dan bukti setoran">
      <incoming>F3</incoming>
      <outgoing>F4</outgoing>
    </manualTask>
    <sequenceFlow id="F1" sourceRef="Start_Daftar" targetRef="Task_IsiForm" />
    <sequenceFlow id="F2" sourceRef="Task_IsiForm" targetRef="Task_SerahSetoran" />
    <sequenceFlow id="F3" sourceRef="Task_SerahSetoran" targetRef="Task_TerimaBerkas" />
    <sequenceFlow id="F4" sourceRef="Task_TerimaBerkas" targetRef="Task_PeriksaKelayakan" />
    <sequenceFlow id="F5" sourceRef="Task_PeriksaKelayakan" targetRef="GW_Syarat" />
    <sequenceFlow id="F6_Tidak" name="Tidak" sourceRef="GW_Syarat" targetRef="Task_Tolak" />
    <sequenceFlow id="F8_Ya" name="Ya" sourceRef="GW_Syarat" targetRef="PG_Split" />
    <endEvent id="End_Tolak" name="Pendaftaran belum diterima">
      <incoming>F7_Tolak</incoming>
    </endEvent>
    <manualTask id="Task_BuatAkses" name="Membuat akses aplikasi anggota">
      <incoming>F9b</incoming>
      <outgoing>F10b</outgoing>
    </manualTask>
    <manualTask id="Task_TerimaAkses" name="Menerima nomor anggota dan akses layanan">
      <incoming>F11</incoming>
      <outgoing>F12</outgoing>
    </manualTask>
    <endEvent id="End_Aktif" name="Anggota aktif">
      <incoming>F12</incoming>
    </endEvent>
    <sequenceFlow id="F7_Tolak" sourceRef="Task_Tolak" targetRef="End_Tolak" />
    <sequenceFlow id="F9a" sourceRef="PG_Split" targetRef="Task_CatatPembukuan" />
    <sequenceFlow id="F9b" sourceRef="PG_Split" targetRef="Task_BuatAkses" />
    <sequenceFlow id="F10a" sourceRef="Task_CatatPembukuan" targetRef="PG_Join" />
    <sequenceFlow id="F10b" sourceRef="Task_BuatAkses" targetRef="PG_Join" />
    <sequenceFlow id="F11" sourceRef="PG_Join" targetRef="Task_TerimaAkses" />
    <sequenceFlow id="F12" sourceRef="Task_TerimaAkses" targetRef="End_Aktif" />
    <parallelGateway id="PG_Join">
      <incoming>F10a</incoming>
      <incoming>F10b</incoming>
      <outgoing>F11</outgoing>
    </parallelGateway>
    <manualTask id="Task_CatatPembukuan" name="Mencatat anggota di pembukuan utama">
      <incoming>F9a</incoming>
      <outgoing>F10a</outgoing>
    </manualTask>
    <parallelGateway id="PG_Split">
      <incoming>F8_Ya</incoming>
      <outgoing>F9a</outgoing>
      <outgoing>F9b</outgoing>
    </parallelGateway>
    <manualTask id="Task_Tolak" name="Memberi penjelasan penolakan atau perbaikan">
      <incoming>F6_Tidak</incoming>
      <outgoing>F7_Tolak</outgoing>
    </manualTask>
    <exclusiveGateway id="GW_Syarat" name="Syarat terpenuhi?">
      <incoming>F5</incoming>
      <outgoing>F6_Tidak</outgoing>
      <outgoing>F8_Ya</outgoing>
    </exclusiveGateway>
    <manualTask id="Task_PeriksaKelayakan" name="Memeriksa kelengkapan dan syarat anggota">
      <incoming>F4</incoming>
      <outgoing>F5</outgoing>
    </manualTask>
  </process>
  <bpmndi:BPMNDiagram id="Diagram_Proc_AsIs_ManajemenAnggota">
    <bpmndi:BPMNPlane id="Plane_Proc_AsIs_ManajemenAnggota" bpmnElement="Collab_AsIs_ManajemenAnggota">
      <bpmndi:BPMNShape id="Participant_AsIs_ManajemenAnggota_di" bpmnElement="Participant_AsIs_ManajemenAnggota" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="1500" height="610" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_4_Pembukuan_Utama_Aplikasi_Ang_di" bpmnElement="Lane_4_Pembukuan_Utama_Aplikasi_Ang" isHorizontal="true">
        <dc:Bounds x="196" y="530" width="1464" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_3_Pengurus_di" bpmnElement="Lane_3_Pengurus" isHorizontal="true">
