      <bpmndi:BPMNShape id="End_Tolak_di" bpmnElement="End_Tolak">
        <dc:Bounds x="1002" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="983" y="84.5" width="73" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PG_Split_di" bpmnElement="PG_Split">
