<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://koperasi.id/bpmn"
             id="AsIs_ManajemenAnggota">
  <collaboration id="Collab_1">
    <participant id="Pool_1" name="KSP Koperasi (As-Is)" processRef="Proc_1"/>
  </collaboration>
  <process id="Proc_1" isExecutable="false">
    <laneSet id="LS_1">
      <lane id="Lane_CA" name="Calon Anggota">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>Task_IsiFisik</flowNodeRef>
        <flowNodeRef>Task_BayarPokok</flowNodeRef>
        <flowNodeRef>Task_DownloadApp</flowNodeRef>
        <flowNodeRef>End_Aktif</flowNodeRef>
        <flowNodeRef>End_Tolak</flowNodeRef>
      </lane>
      <lane id="Lane_Kasir" name="Kasir">
        <flowNodeRef>Task_TerimaFormulir</flowNodeRef>
        <flowNodeRef>Task_BuatAkunAndroid</flowNodeRef>
      </lane>
      <lane id="Lane_Owner" name="Owner (Pengurus)">
        <flowNodeRef>Task_VerifOracle</flowNodeRef>
        <flowNodeRef>GW_Valid</flowNodeRef>
        <flowNodeRef>Task_InputOracle</flowNodeRef>
        <flowNodeRef>Task_InfoTolak</flowNodeRef>
      </lane>
      <lane id="Lane_Oracle" name="Sistem Oracle / Payroll">
        <flowNodeRef>Task_AktifPayroll</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="Calon anggota ingin mendaftar"><outgoing>F1</outgoing></startEvent>
    <userTask id="Task_IsiFisik" name="Mengisi formulir pendaftaran fisik"><incoming>F1</incoming><outgoing>F2</outgoing></userTask>
    <userTask id="Task_BayarPokok" name="Membayar simpanan pokok di kasir"><incoming>F2</incoming><outgoing>F3</outgoing></userTask>
    <userTask id="Task_TerimaFormulir" name="Menerima formulir dari calon anggota"><incoming>F3</incoming><outgoing>F4</outgoing></userTask>
    <userTask id="Task_VerifOracle" name="Verifikasi manual ke Oracle (NIP/kepegawaian)"><incoming>F4</incoming><outgoing>F5</outgoing></userTask>
    <exclusiveGateway id="GW_Valid" name="Data valid dan disetujui?"><incoming>F5</incoming><outgoing>F_Ya</outgoing><outgoing>F_Tidak</outgoing></exclusiveGateway>
    <userTask id="Task_InfoTolak" name="Memberitahu penolakan kepada calon anggota"><incoming>F_Tidak</incoming><outgoing>F_EndTolak</outgoing></userTask>
    <endEvent id="End_Tolak" name="Pendaftaran ditolak"><incoming>F_EndTolak</incoming></endEvent>
    <userTask id="Task_InputOracle" name="Menginput data anggota baru ke Oracle manual"><incoming>F_Ya</incoming><outgoing>F6</outgoing></userTask>
    <userTask id="Task_BuatAkunAndroid" name="Membuat akun login aplikasi Android manual"><incoming>F6</incoming><outgoing>F7</outgoing></userTask>
    <serviceTask id="Task_AktifPayroll" name="Aktifkan pemotongan simpanan wajib via payroll"><incoming>F7</incoming><outgoing>F8</outgoing></serviceTask>
    <userTask id="Task_DownloadApp" name="Download aplikasi Android di Play Store dan login"><incoming>F8</incoming><outgoing>F9</outgoing></userTask>
    <endEvent id="End_Aktif" name="Anggota aktif (Android only)"><incoming>F9</incoming></endEvent>
    <sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_IsiFisik"/>
    <sequenceFlow id="F2" sourceRef="Task_IsiFisik" targetRef="Task_BayarPokok"/>
    <sequenceFlow id="F3" sourceRef="Task_BayarPokok" targetRef="Task_TerimaFormulir"/>
    <sequenceFlow id="F4" sourceRef="Task_TerimaFormulir" targetRef="Task_VerifOracle"/>
    <sequenceFlow id="F5" sourceRef="Task_VerifOracle" targetRef="GW_Valid"/>
    <sequenceFlow id="F_Tidak" name="Tidak" sourceRef="GW_Valid" targetRef="Task_InfoTolak"/>
    <sequenceFlow id="F_EndTolak" sourceRef="Task_InfoTolak" targetRef="End_Tolak"/>
    <sequenceFlow id="F_Ya" name="Ya" sourceRef="GW_Valid" targetRef="Task_InputOracle"/>
    <sequenceFlow id="F6" sourceRef="Task_InputOracle" targetRef="Task_BuatAkunAndroid"/>
    <sequenceFlow id="F7" sourceRef="Task_BuatAkunAndroid" targetRef="Task_AktifPayroll"/>
    <sequenceFlow id="F8" sourceRef="Task_AktifPayroll" targetRef="Task_DownloadApp"/>
    <sequenceFlow id="F9" sourceRef="Task_DownloadApp" targetRef="End_Aktif"/>
  </process>
  <bpmndi:BPMNDiagram id="Diag_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collab_1">
      <bpmndi:BPMNShape id="Pool_1_di" bpmnElement="Pool_1" isHorizontal="true"><dc:Bounds x="100" y="50" width="1200" height="560"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_CA_di" bpmnElement="Lane_CA" isHorizontal="true"><dc:Bounds x="130" y="50" width="1170" height="140"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Kasir_di" bpmnElement="Lane_Kasir" isHorizontal="true"><dc:Bounds x="130" y="190" width="1170" height="130"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Owner_di" bpmnElement="Lane_Owner" isHorizontal="true"><dc:Bounds x="130" y="320" width="1170" height="150"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Oracle_di" bpmnElement="Lane_Oracle" isHorizontal="true"><dc:Bounds x="130" y="470" width="1170" height="140"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1"><dc:Bounds x="162" y="102" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_IsiFisik_di" bpmnElement="Task_IsiFisik"><dc:Bounds x="240" y="82" width="130" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BayarPokok_di" bpmnElement="Task_BayarPokok"><dc:Bounds x="420" y="82" width="130" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TerimaFormulir_di" bpmnElement="Task_TerimaFormulir"><dc:Bounds x="600" y="215" width="130" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_VerifOracle_di" bpmnElement="Task_VerifOracle"><dc:Bounds x="600" y="345" width="130" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Valid_di" bpmnElement="GW_Valid" isMarkerVisible="true"><dc:Bounds x="780" y="358" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_InfoTolak_di" bpmnElement="Task_InfoTolak"><dc:Bounds x="880" y="345" width="130" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Tolak_di" bpmnElement="End_Tolak"><dc:Bounds x="1062" y="363" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_InputOracle_di" bpmnElement="Task_InputOracle"><dc:Bounds x="780" y="490" width="130" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BuatAkunAndroid_di" bpmnElement="Task_BuatAkunAndroid"><dc:Bounds x="940" y="215" width="130" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AktifPayroll_di" bpmnElement="Task_AktifPayroll"><dc:Bounds x="1090" y="490" width="130" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DownloadApp_di" bpmnElement="Task_DownloadApp"><dc:Bounds x="1090" y="82" width="130" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Aktif_di" bpmnElement="End_Aktif"><dc:Bounds x="1252" y="102" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="198" y="120"/><di:waypoint x="240" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="370" y="120"/><di:waypoint x="420" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="485" y="157"/><di:waypoint x="665" y="215"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="665" y="290"/><di:waypoint x="665" y="345"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="730" y="383"/><di:waypoint x="780" y="383"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Tidak_di" bpmnElement="F_Tidak"><di:waypoint x="830" y="383"/><di:waypoint x="880" y="383"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_EndTolak_di" bpmnElement="F_EndTolak"><di:waypoint x="1010" y="383"/><di:waypoint x="1062" y="381"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Ya_di" bpmnElement="F_Ya"><di:waypoint x="805" y="408"/><di:waypoint x="845" y="490"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="845" y="490"/><di:waypoint x="1005" y="253"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="1070" y="253"/><di:waypoint x="1155" y="490"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="1155" y="490"/><di:waypoint x="1155" y="157"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="1220" y="120"/><di:waypoint x="1252" y="120"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>