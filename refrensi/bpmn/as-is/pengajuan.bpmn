<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://koperasi.id/bpmn"
             id="AsIs_Pinjaman">
  <collaboration id="Collab_1">
    <participant id="Pool_1" name="KSP Koperasi — Pinjaman (As-Is)" processRef="Proc_1"/>
  </collaboration>
  <process id="Proc_1" isExecutable="false">
    <laneSet id="LS_1">
      <lane id="Lane_Anggota" name="Anggota">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>Task_AjukanFisikApp</flowNodeRef>
        <flowNodeRef>Task_CekPengumuman</flowNodeRef>
        <flowNodeRef>Task_HadirTTD</flowNodeRef>
        <flowNodeRef>End_Cair</flowNodeRef>
        <flowNodeRef>End_Tolak</flowNodeRef>
      </lane>
      <lane id="Lane_Kasir" name="Kasir">
        <flowNodeRef>Task_KumpulBerkas</flowNodeRef>
        <flowNodeRef>Task_UmumkanJadwal</flowNodeRef>
        <flowNodeRef>Task_InputCairan</flowNodeRef>
      </lane>
      <lane id="Lane_Owner" name="Owner (Pengurus)">
        <flowNodeRef>Task_EvaluasiManual</flowNodeRef>
        <flowNodeRef>GW_Setuju</flowNodeRef>
        <flowNodeRef>Task_InfoTolak</flowNodeRef>
      </lane>
      <lane id="Lane_Payroll" name="Sistem Oracle / Payroll">
        <flowNodeRef>Task_AktifAngsuran</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="Anggota butuh pinjaman"><outgoing>F1</outgoing></startEvent>
    <userTask id="Task_AjukanFisikApp" name="Ajukan via formulir fisik (ke Kasir) atau aplikasi Android"><incoming>F1</incoming><outgoing>F2</outgoing></userTask>
    <userTask id="Task_KumpulBerkas" name="Kasir kumpulkan semua pengajuan (1 periode bulanan)"><incoming>F2</incoming><outgoing>F3</outgoing></userTask>
    <userTask id="Task_EvaluasiManual" name="Owner evaluasi manual dari Oracle: masa kerja, simpanan, riwayat pinjaman, rasio gaji"><incoming>F3</incoming><outgoing>F4</outgoing></userTask>
    <exclusiveGateway id="GW_Setuju" name="Disetujui Owner?"><incoming>F4</incoming><outgoing>F_Tolak</outgoing><outgoing>F_Setuju</outgoing></exclusiveGateway>
    <userTask id="Task_InfoTolak" name="Owner memberitahu penolakan kepada Anggota"><incoming>F_Tolak</incoming><outgoing>F_EndTolak</outgoing></userTask>
    <endEvent id="End_Tolak" name="Pengajuan ditolak"><incoming>F_EndTolak</incoming></endEvent>
    <userTask id="Task_UmumkanJadwal" name="Kasir umumkan jadwal TTD akad di aplikasi Android (tanpa nama peminjam — privasi)"><incoming>F_Setuju</incoming><outgoing>F5</outgoing></userTask>
    <userTask id="Task_CekPengumuman" name="Anggota cek pengumuman jadwal TTD di aplikasi Android"><incoming>F5</incoming><outgoing>F6</outgoing></userTask>
    <userTask id="Task_HadirTTD" name="Hadir fisik ke kantor; TTD akad kredit (materai untuk pinjaman di atas Rp5 juta)"><incoming>F6</incoming><outgoing>F7</outgoing></userTask>
    <userTask id="Task_InputCairan" name="Kasir input konfirmasi pencairan ke Oracle manual"><incoming>F7</incoming><outgoing>F8</outgoing></userTask>
    <serviceTask id="Task_AktifAngsuran" name="Aktifkan pemotongan angsuran bulanan via payroll (maks 5 thn; flat/menurun/efektif)"><incoming>F8</incoming><outgoing>F9</outgoing></serviceTask>
    <endEvent id="End_Cair" name="Dana cair, angsuran berjalan via payroll"><incoming>F9</incoming></endEvent>
    <sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_AjukanFisikApp"/>
    <sequenceFlow id="F2" sourceRef="Task_AjukanFisikApp" targetRef="Task_KumpulBerkas"/>
    <sequenceFlow id="F3" sourceRef="Task_KumpulBerkas" targetRef="Task_EvaluasiManual"/>
    <sequenceFlow id="F4" sourceRef="Task_EvaluasiManual" targetRef="GW_Setuju"/>
    <sequenceFlow id="F_Tolak" name="Tolak" sourceRef="GW_Setuju" targetRef="Task_InfoTolak"/>
    <sequenceFlow id="F_EndTolak" sourceRef="Task_InfoTolak" targetRef="End_Tolak"/>
    <sequenceFlow id="F_Setuju" name="Setuju" sourceRef="GW_Setuju" targetRef="Task_UmumkanJadwal"/>
    <sequenceFlow id="F5" sourceRef="Task_UmumkanJadwal" targetRef="Task_CekPengumuman"/>
    <sequenceFlow id="F6" sourceRef="Task_CekPengumuman" targetRef="Task_HadirTTD"/>
    <sequenceFlow id="F7" sourceRef="Task_HadirTTD" targetRef="Task_InputCairan"/>
    <sequenceFlow id="F8" sourceRef="Task_InputCairan" targetRef="Task_AktifAngsuran"/>
    <sequenceFlow id="F9" sourceRef="Task_AktifAngsuran" targetRef="End_Cair"/>
  </process>
  <bpmndi:BPMNDiagram id="Diag_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collab_1">
      <bpmndi:BPMNShape id="Pool_1_di" bpmnElement="Pool_1" isHorizontal="true"><dc:Bounds x="80" y="50" width="1380" height="560"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Anggota_di" bpmnElement="Lane_Anggota" isHorizontal="true"><dc:Bounds x="110" y="50" width="1350" height="140"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Kasir_di" bpmnElement="Lane_Kasir" isHorizontal="true"><dc:Bounds x="110" y="190" width="1350" height="140"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Owner_di" bpmnElement="Lane_Owner" isHorizontal="true"><dc:Bounds x="110" y="330" width="1350" height="150"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Payroll_di" bpmnElement="Lane_Payroll" isHorizontal="true"><dc:Bounds x="110" y="480" width="1350" height="130"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1"><dc:Bounds x="142" y="102" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AjukanFisikApp_di" bpmnElement="Task_AjukanFisikApp"><dc:Bounds x="220" y="82" width="130" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_KumpulBerkas_di" bpmnElement="Task_KumpulBerkas"><dc:Bounds x="400" y="215" width="130" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EvaluasiManual_di" bpmnElement="Task_EvaluasiManual"><dc:Bounds x="580" y="355" width="130" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Setuju_di" bpmnElement="GW_Setuju" isMarkerVisible="true"><dc:Bounds x="760" y="368" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_InfoTolak_di" bpmnElement="Task_InfoTolak"><dc:Bounds x="860" y="355" width="130" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Tolak_di" bpmnElement="End_Tolak"><dc:Bounds x="1042" y="373" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UmumkanJadwal_di" bpmnElement="Task_UmumkanJadwal"><dc:Bounds x="860" y="215" width="130" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CekPengumuman_di" bpmnElement="Task_CekPengumuman"><dc:Bounds x="1040" y="82" width="130" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_HadirTTD_di" bpmnElement="Task_HadirTTD"><dc:Bounds x="1200" y="82" width="130" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_InputCairan_di" bpmnElement="Task_InputCairan"><dc:Bounds x="1200" y="215" width="130" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AktifAngsuran_di" bpmnElement="Task_AktifAngsuran"><dc:Bounds x="1200" y="495" width="130" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Cair_di" bpmnElement="End_Cair"><dc:Bounds x="1362" y="515" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="178" y="120"/><di:waypoint x="220" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="285" y="157"/><di:waypoint x="465" y="215"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="465" y="290"/><di:waypoint x="645" y="355"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="710" y="393"/><di:waypoint x="760" y="393"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Tolak_di" bpmnElement="F_Tolak"><di:waypoint x="810" y="393"/><di:waypoint x="860" y="393"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_EndTolak_di" bpmnElement="F_EndTolak"><di:waypoint x="990" y="393"/><di:waypoint x="1042" y="391"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Setuju_di" bpmnElement="F_Setuju"><di:waypoint x="785" y="368"/><di:waypoint x="925" y="290"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="990" y="253"/><di:waypoint x="1105" y="157"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="1170" y="120"/><di:waypoint x="1200" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="1265" y="157"/><di:waypoint x="1265" y="215"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="1265" y="290"/><di:waypoint x="1265" y="495"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="1330" y="533"/><di:waypoint x="1362" y="533"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>