<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Proc_AsIs_Pengajuan" targetNamespace="http://smartcoop.id/bpmn/revisi" exporter="Camunda Modeler" exporterVersion="5.47.0">
  <documentation>Revisi BPMN As-Is: proses pengajuan pinjaman berbasis keputusan koperasi, akad fisik, dan pencatatan pembukuan.</documentation>
  <collaboration id="Collab_AsIs_Pengajuan">
    <participant id="Participant_AsIs_Pengajuan" name="Koperasi Simpan Pinjam - As-Is Pengajuan Pinjaman" processRef="Proc_AsIs_Pengajuan" />
  </collaboration>
  <process id="Proc_AsIs_Pengajuan" isExecutable="false">
    <documentation>Revisi BPMN As-Is: proses pengajuan pinjaman berbasis keputusan koperasi, akad fisik, dan pencatatan pembukuan.</documentation>
    <laneSet id="LaneSet_Proc_AsIs_Pengajuan">
      <lane id="Lane_4_Pembukuan_Utama_Aplikasi_Ang" name="Pembukuan Utama &#38; Aplikasi Anggota">
        <flowNodeRef>Task_CatatPinjaman</flowNodeRef>
      </lane>
      <lane id="Lane_3_Pengurus" name="Pengurus">
        <flowNodeRef>Evt_SeleksiBulanan</flowNodeRef>
        <flowNodeRef>IG_Pemeriksaan</flowNodeRef>
        <flowNodeRef>Task_NilaiKemampuan</flowNodeRef>
        <flowNodeRef>IG_Gabung</flowNodeRef>
        <flowNodeRef>GW_Layak</flowNodeRef>
        <flowNodeRef>Task_InfoTunda</flowNodeRef>
        <flowNodeRef>Task_JadwalAkad</flowNodeRef>
        <flowNodeRef>Task_Kumpulkan</flowNodeRef>
      </lane>
      <lane id="Lane_2_Kasir_Keuangan" name="Kasir / Keuangan">
        <flowNodeRef>Task_CekTunggakan</flowNodeRef>
        <flowNodeRef>Task_Cairkan</flowNodeRef>
      </lane>
      <lane id="Lane_1_Anggota" name="Anggota">
        <flowNodeRef>Start_Pinjaman</flowNodeRef>
        <flowNodeRef>Task_Ajukan</flowNodeRef>
        <flowNodeRef>Task_MintaBukti</flowNodeRef>
        <flowNodeRef>End_Ditolak</flowNodeRef>
        <flowNodeRef>Task_Ttd</flowNodeRef>
        <flowNodeRef>End_Aktif</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_Pinjaman" name="Anggota membutuhkan pinjaman">
      <outgoing>F1</outgoing>
    </startEvent>
    <manualTask id="Task_Ajukan" name="Mengajukan permohonan pinjaman">
      <incoming>F1</incoming>
      <outgoing>F2</outgoing>
    </manualTask>
    <intermediateCatchEvent id="Evt_SeleksiBulanan" name="Jadwal seleksi bulanan">
      <incoming>F3</incoming>
      <outgoing>F4</outgoing>
      <timerEventDefinition />
    </intermediateCatchEvent>
    <inclusiveGateway id="IG_Pemeriksaan" name="Pemeriksaan yang diperlukan">
      <incoming>F4</incoming>
      <outgoing>F5a</outgoing>
      <outgoing>F5b</outgoing>
      <outgoing>F5c</outgoing>
    </inclusiveGateway>
    <manualTask id="Task_CekTunggakan" name="Memeriksa simpanan dan tunggakan">
      <incoming>F5a</incoming>
      <outgoing>F6a</outgoing>
    </manualTask>
    <manualTask id="Task_NilaiKemampuan" name="Menilai kemampuan bayar dan kondisi anggota">
      <incoming>F5b</incoming>
      <outgoing>F6b</outgoing>
    </manualTask>
    <manualTask id="Task_MintaBukti" name="Meminta bukti tambahan bila diperlukan">
      <incoming>F5c</incoming>
      <outgoing>F6c</outgoing>
    </manualTask>
    <inclusiveGateway id="IG_Gabung">
      <incoming>F6a</incoming>
      <incoming>F6b</incoming>
      <incoming>F6c</incoming>
      <outgoing>F7</outgoing>
    </inclusiveGateway>
    <exclusiveGateway id="GW_Layak" name="Layak dibiayai?">
      <incoming>F7</incoming>
      <outgoing>F8_Tidak</outgoing>
      <outgoing>F10_Ya</outgoing>
    </exclusiveGateway>
    <manualTask id="Task_InfoTunda" name="Mengumumkan penolakan atau penundaan">
      <incoming>F8_Tidak</incoming>
      <outgoing>F9_Tolak</outgoing>
    </manualTask>
    <endEvent id="End_Ditolak" name="Pengajuan tidak dicairkan">
      <incoming>F9_Tolak</incoming>
    </endEvent>
    <manualTask id="Task_JadwalAkad" name="Mengumumkan jadwal tanda tangan akad">
      <incoming>F10_Ya</incoming>
      <outgoing>F11</outgoing>
    </manualTask>
    <manualTask id="Task_Ttd" name="Hadir dan menandatangani akad bermaterai">
      <incoming>F11</incoming>
      <outgoing>F12</outgoing>
    </manualTask>
    <manualTask id="Task_Cairkan" name="Mencairkan dana pinjaman">
      <incoming>F12</incoming>
      <outgoing>F13</outgoing>
    </manualTask>
    <manualTask id="Task_CatatPinjaman" name="Mencatat pinjaman dan jadwal angsuran">
      <incoming>F13</incoming>
      <outgoing>F14</outgoing>
    </manualTask>
    <endEvent id="End_Aktif" name="Pinjaman berjalan">
      <incoming>F14</incoming>
    </endEvent>
    <manualTask id="Task_Kumpulkan" name="Mengumpulkan pengajuan periode berjalan">
      <incoming>F2</incoming>
      <outgoing>F3</outgoing>
    </manualTask>
    <sequenceFlow id="F1" sourceRef="Start_Pinjaman" targetRef="Task_Ajukan" />
    <sequenceFlow id="F2" sourceRef="Task_Ajukan" targetRef="Task_Kumpulkan" />
    <sequenceFlow id="F3" sourceRef="Task_Kumpulkan" targetRef="Evt_SeleksiBulanan" />
    <sequenceFlow id="F4" sourceRef="Evt_SeleksiBulanan" targetRef="IG_Pemeriksaan" />
    <sequenceFlow id="F5a" name="Cek kewajiban" sourceRef="IG_Pemeriksaan" targetRef="Task_CekTunggakan" />
    <sequenceFlow id="F5b" name="Cek kelayakan" sourceRef="IG_Pemeriksaan" targetRef="Task_NilaiKemampuan" />
    <sequenceFlow id="F5c" name="Jika perlu bukti" sourceRef="IG_Pemeriksaan" targetRef="Task_MintaBukti" />
    <sequenceFlow id="F6a" sourceRef="Task_CekTunggakan" targetRef="IG_Gabung" />
    <sequenceFlow id="F6b" sourceRef="Task_NilaiKemampuan" targetRef="IG_Gabung" />
    <sequenceFlow id="F6c" sourceRef="Task_MintaBukti" targetRef="IG_Gabung" />
    <sequenceFlow id="F7" sourceRef="IG_Gabung" targetRef="GW_Layak" />
    <sequenceFlow id="F8_Tidak" name="Tidak" sourceRef="GW_Layak" targetRef="Task_InfoTunda" />
    <sequenceFlow id="F10_Ya" name="Ya" sourceRef="GW_Layak" targetRef="Task_JadwalAkad" />
    <sequenceFlow id="F9_Tolak" sourceRef="Task_InfoTunda" targetRef="End_Ditolak" />
    <sequenceFlow id="F11" sourceRef="Task_JadwalAkad" targetRef="Task_Ttd" />
    <sequenceFlow id="F12" sourceRef="Task_Ttd" targetRef="Task_Cairkan" />
    <sequenceFlow id="F13" sourceRef="Task_Cairkan" targetRef="Task_CatatPinjaman" />
    <sequenceFlow id="F14" sourceRef="Task_CatatPinjaman" targetRef="End_Aktif" />
  </process>
  <bpmndi:BPMNDiagram id="Diagram_Proc_AsIs_Pengajuan">
    <bpmndi:BPMNPlane id="Plane_Proc_AsIs_Pengajuan" bpmnElement="Collab_AsIs_Pengajuan">
