# Contoh konfigurasi — salin ke .env lalu isi nilainya.
# JANGAN commit berkas .env yang berisi kredensial asli.

# DSN PostgreSQL. Untuk Supabase/Neon, salin "Connection string" (mode pooler/transaction).
# Wajib sslmode=require untuk koneksi hosted.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require

# Secret untuk menandatangani cookie sesi (FR-SEC-02). Gunakan string acak panjang.
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# true saat aplikasi dilayani melalui HTTPS (wajib untuk produksi).
SESSION_SECURE=false

# Port HTTP server (opsional, default 8080).
PORT=8080
