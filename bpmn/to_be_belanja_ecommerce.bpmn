        <dc:Bounds x="1270" y="540" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EC_T_NotifSeller_di" bpmnElement="EC_T_NotifSeller">
        <dc:Bounds x="1270" y="640" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EC_T_TrackPengiriman_di" bpmnElement="EC_T_TrackPengiriman">
        <dc:Bounds x="1420" y="435" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EC_T_HitungPoin_di" bpmnElement="EC_T_HitungPoin">
        <dc:Bounds x="1870" y="435" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EC_T_PotongKomisi_di" bpmnElement="EC_T_PotongKomisi">
        <dc:Bounds x="2020" y="435" width="100" height="80" />
      </bpmndi:BPMNShape>
