<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Defs_TBEC" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.46.1">
  <bpmn:collaboration id="Collab_TBEC">
    <bpmn:participant id="Part_TBEC" name="To-Be: Belanja di Marketplace KopHub E-Commerce" processRef="Proc_TBEC" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_TBEC" name="To-Be: Belanja di Marketplace KopHub E-Commerce" isExecutable="false">
    <bpmn:laneSet id="LS_TBEC">
      <bpmn:lane id="EC_Lane_Seller" name="Seller (Anggota Aktif)">
        <bpmn:flowNodeRef>EC_T_TerimaOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EC_T_ProsesPesanan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EC_T_MarkDikirim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EC_T_InputResi</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="EC_Lane_Sys" name="Sistem KopHub (Otomatis)">
        <bpmn:flowNodeRef>EC_T_ProsesBayar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EC_T_GenInvoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EC_T_UpdateStok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EC_T_NotifSeller</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EC_T_TrackPengiriman</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EC_T_HitungPoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EC_T_PotongKomisi</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="EC_Lane_Buyer" name="Buyer (Anggota / Umum)">
        <bpmn:flowNodeRef>EC_SE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EC_T_Browse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EC_T_Keranjang</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EC_T_Checkout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EC_T_PilihBayar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EC_T_KonfirmBayar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EC_T_TerimaNotifDikirim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EC_T_TerimaBarang</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EC_T_KonfirmTerima</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EC_T_TulisReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EC_EE_Selesai</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="EC_SE" name="Akses Marketplace KopHub">
      <bpmn:outgoing>ECF1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="EC_T_Browse" name="Browse &#38; Cari Produk / Kategori">
      <bpmn:incoming>ECF1</bpmn:incoming>
      <bpmn:outgoing>ECF2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="EC_T_Keranjang" name="Tambah Produk ke Keranjang">
      <bpmn:incoming>ECF2</bpmn:incoming>
      <bpmn:outgoing>ECF3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="EC_T_Checkout" name="Checkout (Pilih Alamat &#38; Ekspedisi, Input Voucher / Poin)">
      <bpmn:incoming>ECF3</bpmn:incoming>
      <bpmn:outgoing>ECF4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="EC_T_PilihBayar" name="Pilih Metode Pembayaran (Transfer / QRIS / Saldo Anggota)">
      <bpmn:incoming>ECF4</bpmn:incoming>
      <bpmn:outgoing>ECF5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="EC_T_KonfirmBayar" name="Konfirmasi &#38; Bayar">
      <bpmn:incoming>ECF5</bpmn:incoming>
      <bpmn:outgoing>ECF6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="EC_T_TerimaNotifDikirim" name="Terima Notifikasi Pesanan Dikirim (Lacak Resi)">
      <bpmn:incoming>ECF12</bpmn:incoming>
      <bpmn:outgoing>ECF13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="EC_T_TerimaBarang" name="Terima Barang dari Ekspedisi">
      <bpmn:incoming>ECF13</bpmn:incoming>
      <bpmn:outgoing>ECF14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="EC_T_KonfirmTerima" name="Konfirmasi Pesanan Diterima di Platform">
      <bpmn:incoming>ECF14</bpmn:incoming>
      <bpmn:outgoing>ECF15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="EC_T_TulisReview" name="Tulis Review &#38; Rating Produk">
      <bpmn:incoming>ECF15</bpmn:incoming>
      <bpmn:outgoing>ECF16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="EC_T_ProsesBayar" name="Proses Pembayaran Otomatis &#38; Validasi" camunda:type="external" camunda:topic="prosesBayar">
      <bpmn:incoming>ECF6</bpmn:incoming>
      <bpmn:outgoing>ECF7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="EC_T_GenInvoice" name="Generate Invoice &#38; Konfirmasi Pembayaran" camunda:type="external" camunda:topic="genInvoice">
      <bpmn:incoming>ECF7</bpmn:incoming>
      <bpmn:outgoing>ECF8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="EC_T_UpdateStok" name="Update Stok Produk Otomatis" camunda:type="external" camunda:topic="updateStok">
      <bpmn:incoming>ECF8</bpmn:incoming>
      <bpmn:outgoing>Flow_1uwiso0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="EC_T_NotifSeller" name="Kirim Notifikasi Pesanan Baru ke Seller" camunda:type="external" camunda:topic="notifSeller">
      <bpmn:incoming>Flow_1uwiso0</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="EC_T_TrackPengiriman" name="Update Status Pengiriman Real-Time" camunda:type="external" camunda:topic="trackPengiriman">
      <bpmn:incoming>ECF_track</bpmn:incoming>
      <bpmn:outgoing>ECF12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="EC_T_HitungPoin" name="Hitung &#38; Tambah Poin Loyalty Otomatis (1% dari Total)" camunda:type="external" camunda:topic="hitungPoin">
      <bpmn:incoming>ECF16</bpmn:incoming>
      <bpmn:outgoing>ECF17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="EC_T_PotongKomisi" name="Potong Komisi Koperasi 3% &#38; Update Pendapatan Seller" camunda:type="external" camunda:topic="komisi">
      <bpmn:incoming>ECF17</bpmn:incoming>
      <bpmn:outgoing>ECF20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="EC_T_TerimaOrder" name="Terima Notifikasi Pesanan Baru di Dashboard Seller">
      <bpmn:outgoing>ECF11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="EC_T_ProsesPesanan" name="Proses &#38; Kemas Pesanan">
      <bpmn:incoming>ECF11</bpmn:incoming>
      <bpmn:outgoing>ECF11b</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="EC_T_MarkDikirim" name="Tandai Pesanan DIKIRIM di Platform">
      <bpmn:incoming>ECF11c</bpmn:incoming>
      <bpmn:outgoing>ECF_track</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="EC_T_InputResi" name="Input Nomor Resi Ekspedisi">
      <bpmn:incoming>ECF11b</bpmn:incoming>
      <bpmn:outgoing>ECF11c</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="ECF1" sourceRef="EC_SE" targetRef="EC_T_Browse" />
    <bpmn:sequenceFlow id="ECF2" sourceRef="EC_T_Browse" targetRef="EC_T_Keranjang" />
    <bpmn:sequenceFlow id="ECF3" sourceRef="EC_T_Keranjang" targetRef="EC_T_Checkout" />
    <bpmn:sequenceFlow id="ECF4" sourceRef="EC_T_Checkout" targetRef="EC_T_PilihBayar" />
    <bpmn:sequenceFlow id="ECF5" sourceRef="EC_T_PilihBayar" targetRef="EC_T_KonfirmBayar" />
    <bpmn:sequenceFlow id="ECF6" sourceRef="EC_T_KonfirmBayar" targetRef="EC_T_ProsesBayar" />
    <bpmn:sequenceFlow id="ECF12" sourceRef="EC_T_TrackPengiriman" targetRef="EC_T_TerimaNotifDikirim" />
    <bpmn:sequenceFlow id="ECF13" sourceRef="EC_T_TerimaNotifDikirim" targetRef="EC_T_TerimaBarang" />
    <bpmn:sequenceFlow id="ECF14" sourceRef="EC_T_TerimaBarang" targetRef="EC_T_KonfirmTerima" />
    <bpmn:sequenceFlow id="ECF15" sourceRef="EC_T_KonfirmTerima" targetRef="EC_T_TulisReview" />
    <bpmn:sequenceFlow id="ECF16" sourceRef="EC_T_TulisReview" targetRef="EC_T_HitungPoin" />
    <bpmn:sequenceFlow id="ECF20" sourceRef="EC_T_PotongKomisi" targetRef="EC_EE_Selesai" />
    <bpmn:sequenceFlow id="ECF7" sourceRef="EC_T_ProsesBayar" targetRef="EC_T_GenInvoice" />
    <bpmn:sequenceFlow id="ECF8" sourceRef="EC_T_GenInvoice" targetRef="EC_T_UpdateStok" />
    <bpmn:sequenceFlow id="Flow_1uwiso0" sourceRef="EC_T_UpdateStok" targetRef="EC_T_NotifSeller" />
    <bpmn:sequenceFlow id="ECF_track" sourceRef="EC_T_MarkDikirim" targetRef="EC_T_TrackPengiriman" />
    <bpmn:sequenceFlow id="ECF17" sourceRef="EC_T_HitungPoin" targetRef="EC_T_PotongKomisi" />
    <bpmn:sequenceFlow id="ECF11" sourceRef="EC_T_TerimaOrder" targetRef="EC_T_ProsesPesanan" />
    <bpmn:sequenceFlow id="ECF11b" sourceRef="EC_T_ProsesPesanan" targetRef="EC_T_InputResi" />
    <bpmn:sequenceFlow id="ECF11c" sourceRef="EC_T_InputResi" targetRef="EC_T_MarkDikirim" />
    <bpmn:endEvent id="EC_EE_Selesai" name="Transaksi Selesai — Poin Loyalty Ditambahkan (1%)">
      <bpmn:incoming>ECF20</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_TBEC">
    <bpmndi:BPMNPlane id="Plane_TBEC" bpmnElement="Collab_TBEC">
      <bpmndi:BPMNShape id="Part_TBEC_di" bpmnElement="Part_TBEC" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1990" height="800" />
      </bpmndi:BPMNShape>
