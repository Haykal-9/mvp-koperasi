      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1uwiso0_di" bpmnElement="Flow_1uwiso0">
        <di:waypoint x="1320" y="620" />
        <di:waypoint x="1320" y="640" />
      </bpmndi:BPMNEdge>
