          <dc:Bounds x="1996" y="168.5" width="87" height="53" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ECF1_di" bpmnElement="ECF1">
        <di:waypoint x="468" y="265" />
        <di:waypoint x="520" y="265" />
      </bpmndi:BPMNEdge>
