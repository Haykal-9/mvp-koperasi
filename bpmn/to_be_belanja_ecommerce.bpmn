        <dc:Bounds x="1270" y="740" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EC_T_ProsesPesanan_di" bpmnElement="EC_T_ProsesPesanan">
        <dc:Bounds x="1430" y="740" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EC_T_MarkDikirim_di" bpmnElement="EC_T_MarkDikirim">
        <dc:Bounds x="1720" y="730" width="100" height="80" />
      </bpmndi:BPMNShape>
