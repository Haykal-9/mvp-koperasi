        <dc:Bounds x="190" y="720" width="1960" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EC_Lane_Sys_di" bpmnElement="EC_Lane_Sys" isHorizontal="true">
