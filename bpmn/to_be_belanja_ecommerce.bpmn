        <dc:Bounds x="1420" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EC_T_TerimaBarang_di" bpmnElement="EC_T_TerimaBarang">
        <dc:Bounds x="1570" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EC_T_KonfirmTerima_di" bpmnElement="EC_T_KonfirmTerima">
        <dc:Bounds x="1720" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EC_T_TulisReview_di" bpmnElement="EC_T_TulisReview">
        <dc:Bounds x="1870" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EC_T_ProsesBayar_di" bpmnElement="EC_T_ProsesBayar">
