        <di:waypoint x="770" y="265" />
        <di:waypoint x="820" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ECF4_di" bpmnElement="ECF4">
        <di:waypoint x="920" y="265" />
        <di:waypoint x="970" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ECF5_di" bpmnElement="ECF5">
        <di:waypoint x="1070" y="265" />
        <di:waypoint x="1120" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ECF6_di" bpmnElement="ECF6">
        <di:waypoint x="1170" y="305" />
        <di:waypoint x="1170" y="435" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ECF12_di" bpmnElement="ECF12">
        <di:waypoint x="1470" y="435" />
        <di:waypoint x="1470" y="305" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ECF13_di" bpmnElement="ECF13">
        <di:waypoint x="1520" y="265" />
        <di:waypoint x="1570" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ECF14_di" bpmnElement="ECF14">
        <di:waypoint x="1670" y="265" />
        <di:waypoint x="1720" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ECF15_di" bpmnElement="ECF15">
        <di:waypoint x="1820" y="265" />
        <di:waypoint x="1870" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ECF16_di" bpmnElement="ECF16">
        <di:waypoint x="1920" y="305" />
        <di:waypoint x="1920" y="435" />
      </bpmndi:BPMNEdge>
