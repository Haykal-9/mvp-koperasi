<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  targetNamespace="http://bpmn.io/schema/bpmn"
  id="Defs_TBPA">

  <bpmn:collaboration id="Collab_TBPA">
    <bpmn:participant id="Part_TBPA" name="To-Be: Pendaftaran Anggota Digital (KopHub)" processRef="Proc_TBPA"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_TBPA" name="To-Be: Pendaftaran Anggota Digital (KopHub)" isExecutable="false">
    <bpmn:laneSet id="LS_TBPA">
      <bpmn:lane id="TB_Lane_CA" name="Calon Anggota">
        <bpmn:flowNodeRef>TB_SE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_T_AP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_T_IFO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_T_UD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_T_TN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_GW_D</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_T_LP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_EE_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_EE_D</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="TB_Lane_SYS" name="Sistem KopHub (Otomatis)">
        <bpmn:flowNodeRef>TB_T_VOT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_T_GNA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_T_KNE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_T_KNT</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="TB_Lane_PG" name="Pengurus / Owner">
        <bpmn:flowNodeRef>TB_T_RD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_GW_PG</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Calon Anggota -->
    <bpmn:startEvent id="TB_SE" name="Buka Platform KopHub">
      <bpmn:outgoing>TBF1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="TB_T_AP" name="Akses Halaman Pendaftaran Online">
      <bpmn:incoming>TBF1</bpmn:incoming>
      <bpmn:outgoing>TBF2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="TB_T_IFO" name="Isi Formulir Pendaftaran Digital (Nama, NIK, Alamat, HP)">
      <bpmn:incoming>TBF2</bpmn:incoming>
      <bpmn:outgoing>TBF3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="TB_T_UD" name="Upload Dokumen Digital (KTP, Foto)">
      <bpmn:incoming>TBF3</bpmn:incoming>
      <bpmn:outgoing>TBF4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="TB_T_TN" name="Terima Notifikasi Status (Email / Dashboard)">
      <bpmn:incoming>TBF9</bpmn:incoming>
      <bpmn:incoming>TBF11</bpmn:incoming>
      <bpmn:outgoing>TBF12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="TB_GW_D" name="Status Pendaftaran?">
      <bpmn:incoming>TBF12</bpmn:incoming>
      <bpmn:outgoing>TBF13</bpmn:outgoing>
      <bpmn:outgoing>TBF14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="TB_T_LP" name="Login &amp; Aktivasi Akun Platform">
      <bpmn:incoming>TBF13</bpmn:incoming>
      <bpmn:outgoing>TBF15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="TB_EE_A" name="Anggota Aktif — Akses Penuh KopHub">
      <bpmn:incoming>TBF15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="TB_EE_D" name="Pendaftaran Ditolak (Notifikasi Dikirim)">
      <bpmn:incoming>TBF14</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sistem KopHub -->
    <bpmn:serviceTask id="TB_T_VOT" name="Validasi Data Otomatis (NIK, Format, Duplikat)" camunda:type="external" camunda:topic="validasiPendaftaran">
      <bpmn:incoming>TBF4</bpmn:incoming>
      <bpmn:outgoing>TBF5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="TB_T_GNA" name="Generate Nomor Anggota (KOP-XXXX) &amp; Simpan ke DB" camunda:type="external" camunda:topic="generateAnggota">
      <bpmn:incoming>TBF8</bpmn:incoming>
      <bpmn:outgoing>TBF9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="TB_T_KNE" name="Kirim Notifikasi Email / SMS — Selamat Bergabung!" camunda:type="external" camunda:topic="kirimNotifikasi">
      <bpmn:incoming>TBF9a</bpmn:incoming>
      <bpmn:outgoing>TBF10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="TB_T_KNT" name="Kirim Notifikasi Penolakan dengan Alasan" camunda:type="external" camunda:topic="kirimNotifikasi">
      <bpmn:incoming>TBF8b</bpmn:incoming>
      <bpmn:outgoing>TBF11</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Pengurus / Owner -->
    <bpmn:userTask id="TB_T_RD" name="Review Data Pendaftaran di Dashboard KopHub">
      <bpmn:incoming>TBF5</bpmn:incoming>
      <bpmn:outgoing>TBF6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="TB_GW_PG" name="Disetujui?">
      <bpmn:incoming>TBF6</bpmn:incoming>
      <bpmn:outgoing>TBF8</bpmn:outgoing>
      <bpmn:outgoing>TBF8b</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="TBF1"  sourceRef="TB_SE"    targetRef="TB_T_AP"/>
    <bpmn:sequenceFlow id="TBF2"  sourceRef="TB_T_AP"  targetRef="TB_T_IFO"/>
    <bpmn:sequenceFlow id="TBF3"  sourceRef="TB_T_IFO" targetRef="TB_T_UD"/>
    <bpmn:sequenceFlow id="TBF4"  sourceRef="TB_T_UD"  targetRef="TB_T_VOT"/>
    <bpmn:sequenceFlow id="TBF5"  sourceRef="TB_T_VOT" targetRef="TB_T_RD"/>
    <bpmn:sequenceFlow id="TBF6"  sourceRef="TB_T_RD"  targetRef="TB_GW_PG"/>
    <bpmn:sequenceFlow id="TBF8"  name="Ya — Setujui" sourceRef="TB_GW_PG" targetRef="TB_T_GNA"/>
    <bpmn:sequenceFlow id="TBF8b" name="Tidak — Tolak" sourceRef="TB_GW_PG" targetRef="TB_T_KNT"/>
    <bpmn:sequenceFlow id="TBF9"  sourceRef="TB_T_GNA" targetRef="TB_T_TN"/>
    <bpmn:sequenceFlow id="TBF9a" sourceRef="TB_T_GNA" targetRef="TB_T_KNE"/>
    <bpmn:sequenceFlow id="TBF10" sourceRef="TB_T_KNE" targetRef="TB_T_TN"/>
    <bpmn:sequenceFlow id="TBF11" sourceRef="TB_T_KNT" targetRef="TB_T_TN"/>
    <bpmn:sequenceFlow id="TBF12" sourceRef="TB_T_TN"  targetRef="TB_GW_D"/>
    <bpmn:sequenceFlow id="TBF13" name="Disetujui" sourceRef="TB_GW_D" targetRef="TB_T_LP"/>
    <bpmn:sequenceFlow id="TBF14" name="Ditolak"   sourceRef="TB_GW_D" targetRef="TB_EE_D"/>
    <bpmn:sequenceFlow id="TBF15" sourceRef="TB_T_LP"  targetRef="TB_EE_A"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_TBPA">
    <bpmndi:BPMNPlane id="Plane_TBPA" bpmnElement="Collab_TBPA">

      <bpmndi:BPMNShape id="Part_TBPA_di" bpmnElement="Part_TBPA" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1360" height="630"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TB_Lane_CA_di" bpmnElement="TB_Lane_CA" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1330" height="210"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TB_Lane_SYS_di" bpmnElement="TB_Lane_SYS" isHorizontal="true">
        <dc:Bounds x="190" y="290" width="1330" height="210"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TB_Lane_PG_di" bpmnElement="TB_Lane_PG" isHorizontal="true">
        <dc:Bounds x="190" y="500" width="1330" height="210"/>
      </bpmndi:BPMNShape>

      <!-- Calon Anggota (y-center=185) -->
      <bpmndi:BPMNShape id="TB_SE_di" bpmnElement="TB_SE">
        <dc:Bounds x="222" y="167" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="198" y="210" width="84" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TB_T_AP_di" bpmnElement="TB_T_AP">
        <dc:Bounds x="310" y="145" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TB_T_IFO_di" bpmnElement="TB_T_IFO">
        <dc:Bounds x="460" y="145" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TB_T_UD_di" bpmnElement="TB_T_UD">
        <dc:Bounds x="610" y="145" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TB_T_TN_di" bpmnElement="TB_T_TN">
        <dc:Bounds x="940" y="145" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TB_GW_D_di" bpmnElement="TB_GW_D" isMarkerVisible="true">
        <dc:Bounds x="1095" y="160" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1078" y="136" width="84" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TB_T_LP_di" bpmnElement="TB_T_LP">
        <dc:Bounds x="1200" y="145" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TB_EE_A_di" bpmnElement="TB_EE_A">
        <dc:Bounds x="1362" y="167" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1336" y="210" width="88" height="40"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TB_EE_D_di" bpmnElement="TB_EE_D">
        <dc:Bounds x="1200" y="252" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1174" y="295" width="88" height="40"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Sistem KopHub (y-center=395) -->
      <bpmndi:BPMNShape id="TB_T_VOT_di" bpmnElement="TB_T_VOT">
        <dc:Bounds x="610" y="355" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TB_T_GNA_di" bpmnElement="TB_T_GNA">
        <dc:Bounds x="800" y="355" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TB_T_KNE_di" bpmnElement="TB_T_KNE">
        <dc:Bounds x="950" y="355" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TB_T_KNT_di" bpmnElement="TB_T_KNT">
        <dc:Bounds x="1150" y="355" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <!-- Pengurus (y-center=605) -->
      <bpmndi:BPMNShape id="TB_T_RD_di" bpmnElement="TB_T_RD">
        <dc:Bounds x="610" y="565" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TB_GW_PG_di" bpmnElement="TB_GW_PG" isMarkerVisible="true">
        <dc:Bounds x="760" y="580" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="748" y="556" width="74" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNEdge id="TBF1_di"  bpmnElement="TBF1"><di:waypoint x="258" y="185"/><di:waypoint x="310" y="185"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="TBF2_di"  bpmnElement="TBF2"><di:waypoint x="410" y="185"/><di:waypoint x="460" y="185"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="TBF3_di"  bpmnElement="TBF3"><di:waypoint x="560" y="185"/><di:waypoint x="610" y="185"/></bpmndi:BPMNEdge>
      <!-- cross-lane down: UploadDokumen → ValidasiOtomatis -->
      <bpmndi:BPMNEdge id="TBF4_di"  bpmnElement="TBF4">
        <di:waypoint x="660" y="225"/><di:waypoint x="660" y="355"/>
      </bpmndi:BPMNEdge>
      <!-- cross-lane down: ValidasiOtomatis → ReviewDashboard -->
      <bpmndi:BPMNEdge id="TBF5_di"  bpmnElement="TBF5">
        <di:waypoint x="660" y="435"/><di:waypoint x="660" y="565"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="TBF6_di"  bpmnElement="TBF6"><di:waypoint x="710" y="605"/><di:waypoint x="760" y="605"/></bpmndi:BPMNEdge>
      <!-- Ya: cross-lane up to GenerateNomor -->
      <bpmndi:BPMNEdge id="TBF8_di"  bpmnElement="TBF8">
        <di:waypoint x="785" y="580"/><di:waypoint x="785" y="500"/><di:waypoint x="850" y="500"/><di:waypoint x="850" y="435"/>
        <bpmndi:BPMNLabel><dc:Bounds x="791" y="508" width="56" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <!-- Tidak: cross-lane up to KirimNotifTolak -->
      <bpmndi:BPMNEdge id="TBF8b_di" bpmnElement="TBF8b">
        <di:waypoint x="810" y="605"/><di:waypoint x="1200" y="605"/><di:waypoint x="1200" y="500"/><di:waypoint x="1200" y="435"/>
        <bpmndi:BPMNLabel><dc:Bounds x="958" y="588" width="68" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <!-- GenerateNomor → TerimaNotif (cross-lane up) -->
      <bpmndi:BPMNEdge id="TBF9_di"  bpmnElement="TBF9">
        <di:waypoint x="900" y="355"/><di:waypoint x="990" y="355"/><di:waypoint x="990" y="225"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="TBF9a_di" bpmnElement="TBF9a"><di:waypoint x="900" y="395"/><di:waypoint x="950" y="395"/></bpmndi:BPMNEdge>
      <!-- KirimNotifEmail → TerimaNotif (cross-lane up) -->
      <bpmndi:BPMNEdge id="TBF10_di" bpmnElement="TBF10">
        <di:waypoint x="1050" y="355"/><di:waypoint x="1050" y="290"/><di:waypoint x="990" y="290"/><di:waypoint x="990" y="225"/>
      </bpmndi:BPMNEdge>
      <!-- KirimNotifTolak → TerimaNotif (cross-lane up) -->
      <bpmndi:BPMNEdge id="TBF11_di" bpmnElement="TBF11">
        <di:waypoint x="1200" y="355"/><di:waypoint x="1120" y="355"/><di:waypoint x="1120" y="290"/><di:waypoint x="990" y="290"/><di:waypoint x="990" y="225"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="TBF12_di" bpmnElement="TBF12"><di:waypoint x="1040" y="185"/><di:waypoint x="1095" y="185"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="TBF13_di" bpmnElement="TBF13">
        <di:waypoint x="1145" y="185"/><di:waypoint x="1200" y="185"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1153" y="168" width="44" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="TBF14_di" bpmnElement="TBF14">
        <di:waypoint x="1120" y="210"/><di:waypoint x="1120" y="270"/><di:waypoint x="1200" y="270"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1128" y="232" width="38" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="TBF15_di" bpmnElement="TBF15"><di:waypoint x="1300" y="185"/><di:waypoint x="1362" y="185"/></bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
