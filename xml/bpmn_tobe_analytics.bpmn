<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ToBeAnalytics" targetNamespace="http://smartmart.koperasi/bpmn" exporter="Camunda Modeler" exporterVersion="5.46.1">
  <bpmn:collaboration id="Collab_ToBeAnalytics">
    <bpmn:participant id="Part_ToBeAnalytics" name="Dashboard Admin SmartMart (To-Be) — Pemantauan Kinerja &#38; Analytics" processRef="Proc_ToBeAnalytics" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_ToBeAnalytics" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ToBeAnalytics">
      <bpmn:lane id="Lane_ToBeAnalytics_0" name="Sistem SmartMart">
        <bpmn:flowNodeRef>AN_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AN_agg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AN_kpi1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AN_kpi2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AN_render</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AN_end_no</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ToBeAnalytics_1" name="Administrator (Pengurus)">
        <bpmn:flowNodeRef>AN_buka</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AN_analisis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AN_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AN_putus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AN_end_ok</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="AN_start" name="Order berstatus&#10;SELESAI tercatat">
      <bpmn:outgoing>an1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="AN_agg" name="Agregasi otomatis&#10;data transaksi">
      <bpmn:incoming>an1</bpmn:incoming>
      <bpmn:outgoing>an2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AN_kpi1" name="Hitung Total Revenue,&#10;Total Order, Status Breakdown">
      <bpmn:incoming>an2</bpmn:incoming>
      <bpmn:outgoing>an3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AN_kpi2" name="Hitung Top Products &#38;&#10;Seller Performance">
      <bpmn:incoming>an3</bpmn:incoming>
      <bpmn:outgoing>an4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AN_buka" name="Buka halaman&#10;/ecommerce/admin/analytics">
      <bpmn:incoming>an4</bpmn:incoming>
      <bpmn:outgoing>an5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AN_render" name="Render kartu ringkasan,&#10;tabel seller, produk terlaris">
      <bpmn:incoming>an5</bpmn:incoming>
      <bpmn:outgoing>an6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AN_analisis" name="Analisis metrik&#10;secara real-time">
      <bpmn:incoming>an6</bpmn:incoming>
      <bpmn:outgoing>an7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="AN_gw" name="Perlu tindakan&#10;strategis?">
      <bpmn:incoming>an7</bpmn:incoming>
      <bpmn:outgoing>an8</bpmn:outgoing>
      <bpmn:outgoing>an10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="AN_putus" name="Ambil keputusan: insentif&#10;seller / promosi produk">
      <bpmn:incoming>an8</bpmn:incoming>
      <bpmn:outgoing>an9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="AN_end_ok" name="Keputusan berbasis&#10;data diambil">
      <bpmn:incoming>an9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="AN_end_no" name="Monitoring selesai">
      <bpmn:incoming>an10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="an1" sourceRef="AN_start" targetRef="AN_agg" />
    <bpmn:sequenceFlow id="an2" sourceRef="AN_agg" targetRef="AN_kpi1" />
    <bpmn:sequenceFlow id="an3" sourceRef="AN_kpi1" targetRef="AN_kpi2" />
    <bpmn:sequenceFlow id="an4" sourceRef="AN_kpi2" targetRef="AN_buka" />
    <bpmn:sequenceFlow id="an5" sourceRef="AN_buka" targetRef="AN_render" />
    <bpmn:sequenceFlow id="an6" sourceRef="AN_render" targetRef="AN_analisis" />
    <bpmn:sequenceFlow id="an7" sourceRef="AN_analisis" targetRef="AN_gw" />
    <bpmn:sequenceFlow id="an8" name="Ya" sourceRef="AN_gw" targetRef="AN_putus" />
    <bpmn:sequenceFlow id="an9" sourceRef="AN_putus" targetRef="AN_end_ok" />
    <bpmn:sequenceFlow id="an10" name="Tidak" sourceRef="AN_gw" targetRef="AN_end_no" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_ToBeAnalytics">
    <bpmndi:BPMNPlane id="Plane_ToBeAnalytics" bpmnElement="Collab_ToBeAnalytics">
      <bpmndi:BPMNShape id="Part_ToBeAnalytics_di" bpmnElement="Part_ToBeAnalytics" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2200" height="340" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ToBeAnalytics_1_di" bpmnElement="Lane_ToBeAnalytics_1" isHorizontal="true">
        <dc:Bounds x="190" y="250" width="2170" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ToBeAnalytics_0_di" bpmnElement="Lane_ToBeAnalytics_0" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="2170" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AN_start_di" bpmnElement="AN_start">
