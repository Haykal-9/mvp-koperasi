      <bpmndi:BPMNShape id="AN_analisis_di" bpmnElement="AN_analisis">
        <dc:Bounds x="1480" y="295" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AN_gw_di" bpmnElement="AN_gw" isMarkerVisible="true">
        <dc:Bounds x="1750" y="310" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1725" y="364" width="100" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AN_putus_di" bpmnElement="AN_putus">
        <dc:Bounds x="1900" y="295" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AN_end_ok_di" bpmnElement="AN_end_ok">
        <dc:Bounds x="2177" y="317" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2145" y="357" width="100" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AN_end_no_di" bpmnElement="AN_end_no">
