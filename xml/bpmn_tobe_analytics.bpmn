        <di:waypoint x="323" y="165" />
        <di:waypoint x="430" y="165" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="an2_di" bpmnElement="an2">
        <di:waypoint x="600" y="165" />
        <di:waypoint x="640" y="165" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="an3_di" bpmnElement="an3">
        <di:waypoint x="810" y="165" />
        <di:waypoint x="850" y="165" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="an4_di" bpmnElement="an4">
        <di:waypoint x="1020" y="165" />
