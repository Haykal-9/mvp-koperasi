<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ToBeVerifAnggota" targetNamespace="http://smartmart.koperasi/bpmn" exporter="Camunda Modeler" exporterVersion="5.46.1">
  <bpmn:collaboration id="Collab_ToBeVerifAnggota">
    <bpmn:participant id="Part_ToBeVerifAnggota" name="Dashboard Admin SmartMart (To-Be) — Verifikasi &#38; Manajemen Keanggotaan" processRef="Proc_ToBeVerifAnggota" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_ToBeVerifAnggota" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ToBeVerifAnggota">
      <bpmn:lane id="Lane_ToBeVerifAnggota_0" name="Calon Anggota / Pengurus OWNER">
        <bpmn:flowNodeRef>TV_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TV_reg</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ToBeVerifAnggota_1" name="Sistem SmartMart">
        <bpmn:flowNodeRef>TV_simpan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TV_tampil</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TV_aktif</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TV_logok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TV_end_ok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ToBeVerifAnggota_2" name="Administrator (Pengurus)">
        <bpmn:flowNodeRef>TV_tinjau</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TV_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TV_tolak</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TV_logno</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TV_end_no</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="TV_start" name="Calon anggota&#10;ingin mendaftar">
      <bpmn:outgoing>tv1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="TV_reg" name="Registrasi mandiri via Sign Up&#10;atau didaftarkan pengurus OWNER&#10;via /members/register">
      <bpmn:incoming>tv1</bpmn:incoming>
      <bpmn:outgoing>tv2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="TV_simpan" name="Simpan data pendaftaran&#10;ke basis data">
      <bpmn:incoming>tv2</bpmn:incoming>
      <bpmn:outgoing>tv3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="TV_tampil" name="Tampilkan user di&#10;/ecommerce/admin/members">
      <bpmn:incoming>tv3</bpmn:incoming>
      <bpmn:outgoing>tv4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="TV_tinjau" name="Tinjau data&#10;pengguna terdaftar">
      <bpmn:incoming>tv4</bpmn:incoming>
      <bpmn:outgoing>tv5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="TV_gw" name="Setujui anggota?">
      <bpmn:incoming>tv5</bpmn:incoming>
      <bpmn:outgoing>tv6</bpmn:outgoing>
      <bpmn:outgoing>tv9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="TV_aktif" name="Aktifkan akun &#38;&#10;tetapkan role anggota">
      <bpmn:incoming>tv6</bpmn:incoming>
      <bpmn:outgoing>tv7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="TV_logok" name="LogAuditAction&#10;(ACTIVATE_MEMBER)">
      <bpmn:incoming>tv7</bpmn:incoming>
      <bpmn:outgoing>tv8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="TV_end_ok" name="Anggota aktif &#38;&#10;dapat bertransaksi">
      <bpmn:incoming>tv8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="TV_tolak" name="Tolak / nonaktifkan akun&#10;(dengan catatan moderasi)">
      <bpmn:incoming>tv9</bpmn:incoming>
      <bpmn:outgoing>tv10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="TV_logno" name="LogAuditAction&#10;(REJECT_MEMBER)">
      <bpmn:incoming>tv10</bpmn:incoming>
      <bpmn:outgoing>tv11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="TV_end_no" name="Akun ditolak /&#10;dimoderasi">
      <bpmn:incoming>tv11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="tv1" sourceRef="TV_start" targetRef="TV_reg" />
    <bpmn:sequenceFlow id="tv2" sourceRef="TV_reg" targetRef="TV_simpan" />
    <bpmn:sequenceFlow id="tv3" sourceRef="TV_simpan" targetRef="TV_tampil" />
    <bpmn:sequenceFlow id="tv4" sourceRef="TV_tampil" targetRef="TV_tinjau" />
    <bpmn:sequenceFlow id="tv5" sourceRef="TV_tinjau" targetRef="TV_gw" />
    <bpmn:sequenceFlow id="tv6" name="Ya, setujui" sourceRef="TV_gw" targetRef="TV_aktif" />
    <bpmn:sequenceFlow id="tv7" sourceRef="TV_aktif" targetRef="TV_logok" />
    <bpmn:sequenceFlow id="tv8" sourceRef="TV_logok" targetRef="TV_end_ok" />
    <bpmn:sequenceFlow id="tv9" name="Tidak" sourceRef="TV_gw" targetRef="TV_tolak" />
    <bpmn:sequenceFlow id="tv10" sourceRef="TV_tolak" targetRef="TV_logno" />
    <bpmn:sequenceFlow id="tv11" sourceRef="TV_logno" targetRef="TV_end_no" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_ToBeVerifAnggota">
    <bpmndi:BPMNPlane id="Plane_ToBeVerifAnggota" bpmnElement="Collab_ToBeVerifAnggota">
      <bpmndi:BPMNShape id="Part_ToBeVerifAnggota_di" bpmnElement="Part_ToBeVerifAnggota" isHorizontal="true">
