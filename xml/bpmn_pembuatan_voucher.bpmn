<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_PembuatanVoucher"
                  targetNamespace="http://smartmart.koperasi/bpmn">
  <bpmn:collaboration id="Collaboration_2">
    <bpmn:participant id="Participant_AdminV" name="Dashboard Admin SmartMart — Alur Pembuatan Voucher" processRef="Process_PembuatanVoucher" />
  </bpmn:collaboration>

  <bpmn:process id="Process_PembuatanVoucher" isExecutable="false">
    <bpmn:laneSet id="LaneSet_V">
      <bpmn:lane id="Lane_AdminV" name="Administrator (Pengurus)">
        <bpmn:flowNodeRef>StartEvent_V</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BukaVoucher</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IsiForm</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SystemV" name="Sistem SmartMart">
        <bpmn:flowNodeRef>Task_ValidasiInput</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PesanError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SimpanVoucher</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LogAuditV</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Error</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_V" name="Admin ingin&#10;buat voucher baru">
      <bpmn:outgoing>FV_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_BukaVoucher" name="Buka halaman /ecommerce/admin/vouchers">
      <bpmn:incoming>FV_1</bpmn:incoming>
      <bpmn:outgoing>FV_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_IsiForm" name="Isi form: code, tipe, nilai, kuota, min pembelian">
      <bpmn:incoming>FV_2</bpmn:incoming>
      <bpmn:outgoing>FV_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ValidasiInput" name="Validasi: code unik, nilai &gt; 0, tipe PERCENT/FIXED">
      <bpmn:incoming>FV_3</bpmn:incoming>
      <bpmn:outgoing>FV_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Valid" name="Valid?">
      <bpmn:incoming>FV_4</bpmn:incoming>
      <bpmn:outgoing>FV_OK</bpmn:outgoing>
      <bpmn:outgoing>FV_Err</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_PesanError" name="Tampilkan pesan error&#10;ke form">
      <bpmn:incoming>FV_Err</bpmn:incoming>
      <bpmn:outgoing>FV_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SimpanVoucher" name="AddVoucher() —&#10;status = ACTIVE,&#10;BerlakuSampai = +3 bulan">
      <bpmn:incoming>FV_OK</bpmn:incoming>
      <bpmn:outgoing>FV_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_LogAuditV" name="LogAuditAction(CREATE_VOUCHER, voucher:&lt;code&gt;)">
      <bpmn:incoming>FV_6</bpmn:incoming>
      <bpmn:outgoing>FV_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_OK" name="Voucher tampil di&#10;daftar voucher aktif">
      <bpmn:incoming>FV_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Error" name="Form re-render&#10;dengan error message">
      <bpmn:incoming>FV_5</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="FV_1" sourceRef="StartEvent_V" targetRef="Task_BukaVoucher" />
    <bpmn:sequenceFlow id="FV_2" sourceRef="Task_BukaVoucher" targetRef="Task_IsiForm" />
    <bpmn:sequenceFlow id="FV_3" sourceRef="Task_IsiForm" targetRef="Task_ValidasiInput" />
    <bpmn:sequenceFlow id="FV_4" sourceRef="Task_ValidasiInput" targetRef="Gateway_Valid" />
    <bpmn:sequenceFlow id="FV_OK" name="Ya" sourceRef="Gateway_Valid" targetRef="Task_SimpanVoucher" />
    <bpmn:sequenceFlow id="FV_Err" name="Tidak" sourceRef="Gateway_Valid" targetRef="Task_PesanError" />
    <bpmn:sequenceFlow id="FV_5" sourceRef="Task_PesanError" targetRef="EndEvent_Error" />
    <bpmn:sequenceFlow id="FV_6" sourceRef="Task_SimpanVoucher" targetRef="Task_LogAuditV" />
    <bpmn:sequenceFlow id="FV_7" sourceRef="Task_LogAuditV" targetRef="EndEvent_OK" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_2">
    <bpmndi:BPMNPlane id="BPMNPlane_2" bpmnElement="Collaboration_2">
      <bpmndi:BPMNShape id="Participant_AdminV_di" bpmnElement="Participant_AdminV" isHorizontal="true">
        <dc:Bounds x="100" y="80" width="1500" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_AdminV_di" bpmnElement="Lane_AdminV" isHorizontal="true">
        <dc:Bounds x="130" y="80" width="1470" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_SystemV_di" bpmnElement="Lane_SystemV" isHorizontal="true">
        <dc:Bounds x="130" y="260" width="1470" height="220" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_V_di" bpmnElement="StartEvent_V">
        <dc:Bounds x="180" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="160" y="195" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BukaVoucher_di" bpmnElement="Task_BukaVoucher">
        <dc:Bounds x="270" y="130" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_IsiForm_di" bpmnElement="Task_IsiForm">
        <dc:Bounds x="500" y="130" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ValidasiInput_di" bpmnElement="Task_ValidasiInput">
        <dc:Bounds x="500" y="320" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Valid_di" bpmnElement="Gateway_Valid" isMarkerVisible="true">
        <dc:Bounds x="730" y="335" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="744" y="390" width="22" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PesanError_di" bpmnElement="Task_PesanError">
        <dc:Bounds x="820" y="410" width="160" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SimpanVoucher_di" bpmnElement="Task_SimpanVoucher">
        <dc:Bounds x="820" y="290" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_LogAuditV_di" bpmnElement="Task_LogAuditV">
        <dc:Bounds x="1060" y="290" width="200" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_OK_di" bpmnElement="EndEvent_OK">
        <dc:Bounds x="1320" y="312" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1290" y="355" width="120" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Error_di" bpmnElement="EndEvent_Error">
        <dc:Bounds x="1020" y="422" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="990" y="465" width="120" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="FV_1_di" bpmnElement="FV_1">
        <di:waypoint x="216" y="170" />
        <di:waypoint x="270" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FV_2_di" bpmnElement="FV_2">
        <di:waypoint x="450" y="170" />
        <di:waypoint x="500" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FV_3_di" bpmnElement="FV_3">
        <di:waypoint x="590" y="210" />
        <di:waypoint x="590" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FV_4_di" bpmnElement="FV_4">
        <di:waypoint x="680" y="360" />
        <di:waypoint x="730" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FV_OK_di" bpmnElement="FV_OK">
        <di:waypoint x="755" y="335" />
        <di:waypoint x="755" y="320" />
        <di:waypoint x="820" y="320" />
        <bpmndi:BPMNLabel><dc:Bounds x="760" y="305" width="18" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FV_Err_di" bpmnElement="FV_Err">
        <di:waypoint x="755" y="385" />
        <di:waypoint x="755" y="440" />
        <di:waypoint x="820" y="440" />
        <bpmndi:BPMNLabel><dc:Bounds x="760" y="450" width="30" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FV_5_di" bpmnElement="FV_5">
        <di:waypoint x="980" y="440" />
        <di:waypoint x="1020" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FV_6_di" bpmnElement="FV_6">
        <di:waypoint x="1000" y="330" />
        <di:waypoint x="1060" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FV_7_di" bpmnElement="FV_7">
        <di:waypoint x="1260" y="330" />
        <di:waypoint x="1320" y="330" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
