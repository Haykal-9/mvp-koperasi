<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_AsIsVerifAnggota" targetNamespace="http://smartmart.koperasi/bpmn" exporter="Camunda Modeler" exporterVersion="5.46.1">
  <bpmn:collaboration id="Collab_AsIsVerifAnggota">
    <bpmn:participant id="Part_AsIsVerifAnggota" name="Koperasi Konvensional (As-Is) — Verifikasi Pendaftaran Anggota Baru" processRef="Proc_AsIsVerifAnggota" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_AsIsVerifAnggota" isExecutable="false">
    <bpmn:laneSet id="LaneSet_AsIsVerifAnggota">
      <bpmn:lane id="Lane_AsIsVerifAnggota_0" name="Calon Anggota">
        <bpmn:flowNodeRef>AV_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AV_isi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AV_serah</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AV_end_no</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AsIsVerifAnggota_1" name="Pengurus Koperasi">
        <bpmn:flowNodeRef>AV_periksa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AV_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AV_catat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AV_arsip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AV_end_ok</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="AV_start" name="Calon anggota&#10;ingin mendaftar">
      <bpmn:outgoing>av1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="AV_isi" name="Isi formulir &#38; siapkan&#10;fotokopi KTP, KK">
      <bpmn:incoming>av1</bpmn:incoming>
      <bpmn:outgoing>av2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AV_serah" name="Serahkan berkas fisik&#10;ke kantor koperasi">
      <bpmn:incoming>av2</bpmn:incoming>
      <bpmn:outgoing>av3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AV_periksa" name="Periksa kelengkapan&#10;berkas satu per satu">
      <bpmn:incoming>av3</bpmn:incoming>
      <bpmn:outgoing>av4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="AV_gw" name="Berkas lengkap?">
      <bpmn:incoming>av4</bpmn:incoming>
      <bpmn:outgoing>av5</bpmn:outgoing>
      <bpmn:outgoing>av6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="AV_catat" name="Catat data ke&#10;buku induk keanggotaan">
      <bpmn:incoming>av5</bpmn:incoming>
      <bpmn:outgoing>av7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AV_arsip" name="Arsipkan dokumen di&#10;lemari penyimpanan fisik">
      <bpmn:incoming>av7</bpmn:incoming>
      <bpmn:outgoing>av8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="AV_end_ok" name="Anggota tercatat manual&#10;(pencarian data lambat)">
      <bpmn:incoming>av8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="AV_end_no" name="Berkas dikembalikan,&#10;pendaftaran tertunda&#10;(tanpa notifikasi)">
      <bpmn:incoming>av6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="av1" sourceRef="AV_start" targetRef="AV_isi" />
    <bpmn:sequenceFlow id="av2" sourceRef="AV_isi" targetRef="AV_serah" />
    <bpmn:sequenceFlow id="av3" sourceRef="AV_serah" targetRef="AV_periksa" />
    <bpmn:sequenceFlow id="av4" sourceRef="AV_periksa" targetRef="AV_gw" />
    <bpmn:sequenceFlow id="av5" name="Ya, lengkap" sourceRef="AV_gw" targetRef="AV_catat" />
    <bpmn:sequenceFlow id="av6" name="Tidak" sourceRef="AV_gw" targetRef="AV_end_no" />
    <bpmn:sequenceFlow id="av7" sourceRef="AV_catat" targetRef="AV_arsip" />
    <bpmn:sequenceFlow id="av8" sourceRef="AV_arsip" targetRef="AV_end_ok" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_AsIsVerifAnggota">
    <bpmndi:BPMNPlane id="Plane_AsIsVerifAnggota" bpmnElement="Collab_AsIsVerifAnggota">
      <bpmndi:BPMNShape id="Part_AsIsVerifAnggota_di" bpmnElement="Part_AsIsVerifAnggota" isHorizontal="true">
